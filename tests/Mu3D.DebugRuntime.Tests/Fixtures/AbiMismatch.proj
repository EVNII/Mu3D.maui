<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <PackageId>Mu3D.Native.Wgpu.DebugRuntime.iOS</PackageId>
  </PropertyGroup>

  <Import Project="$(Mu3DRepositoryRoot)/src/Mu3D.Native.Wgpu.DebugRuntime.iOS/buildTransitive/Mu3D.Native.Wgpu.DebugRuntime.iOS.props" />
  <Import Project="$(Mu3DRepositoryRoot)/src/Mu3D.Native.Wgpu/buildTransitive/Mu3D.Native.Wgpu.targets" />
  <Import Project="$(Mu3DRepositoryRoot)/src/Mu3D.Native.Wgpu.DebugRuntime.iOS/buildTransitive/Mu3D.Native.Wgpu.DebugRuntime.iOS.targets" />

  <PropertyGroup>
    <Mu3DNativeWgpuAbiVersion>v0.0.0.0</Mu3DNativeWgpuAbiVersion>
    <_Mu3DDebugRuntimeDirectory>$(MSBuildThisFileDirectory)assets</_Mu3DDebugRuntimeDirectory>
  </PropertyGroup>

  <Target Name="PrepareForBuild" />
  <Target Name="Verify" DependsOnTargets="PrepareForBuild" />
</Project>
