<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <PackageId>Mu3D.Native.Wgpu.DebugRuntime.Android</PackageId>
  </PropertyGroup>

  <Import Project="$(Mu3DRepositoryRoot)/src/Mu3D.Native.Wgpu.DebugRuntime.Android/buildTransitive/Mu3D.Native.Wgpu.DebugRuntime.Android.props" />
  <Import Project="$(Mu3DRepositoryRoot)/src/Mu3D.Native.Wgpu/buildTransitive/Mu3D.Native.Wgpu.targets" />
  <Import Project="$(Mu3DRepositoryRoot)/src/Mu3D.Native.Wgpu.DebugRuntime.Android/buildTransitive/Mu3D.Native.Wgpu.DebugRuntime.Android.targets" />

  <PropertyGroup>
    <_Mu3DDebugRuntimeRoot>$(MSBuildThisFileDirectory)assets</_Mu3DDebugRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <NativeCopyLocalItems Include="release/libwgpu_native.so" />
    <RuntimeTargetsCopyLocalItems Include="release/libwgpu_native.so" />
  </ItemGroup>

  <Target Name="ResolvePackageAssets" />
  <Target Name="ResolveCopyLocalAssets" DependsOnTargets="ResolvePackageAssets" />
  <Target Name="Verify" DependsOnTargets="ResolveCopyLocalAssets">
    <Error Condition="'@(NativeCopyLocalItems->Count())' != '0'" Text="Release NativeCopyLocalItems were not removed." />
    <Error Condition="'@(RuntimeTargetsCopyLocalItems->Count())' != '0'" Text="Release RuntimeTargetsCopyLocalItems were not removed." />
    <Error Condition="'@(AndroidNativeLibrary->Count())' != '4'" Text="Expected four Debug AndroidNativeLibrary items." />
    <Message Importance="high" Text="Verified four Debug AndroidNativeLibrary items" />
  </Target>
</Project>
