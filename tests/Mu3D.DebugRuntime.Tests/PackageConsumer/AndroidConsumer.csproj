<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mu3D.Native.Wgpu.DebugRuntime.Android" Version="1.0.0" />
  </ItemGroup>
  <Target Name="VerifyDebugRuntimePackage" DependsOnTargets="PrepareForBuild;ResolvePackageAssets">
    <ItemGroup>
      <_Mu3DUnexpectedAndroidNativeLibrary Include="@(AndroidNativeLibrary)"
          Condition="!$([System.String]::Copy('%(AndroidNativeLibrary.Identity)').Contains('mu3d-debug-runtimes'))" />
    </ItemGroup>
    <Error Condition="'@(AndroidNativeLibrary->Count())' != '4'"
           Text="Expected four Debug Android native inputs, got @(AndroidNativeLibrary->Count())." />
    <Error Condition="'@(_Mu3DUnexpectedAndroidNativeLibrary->Count())' != '0'"
           Text="A selected Android native input is not from the DebugRuntime package: @(_Mu3DUnexpectedAndroidNativeLibrary)" />
    <Error Condition="'@(NativeCopyLocalItems->WithMetadataValue('Filename', 'libwgpu_native')->Count())' != '0'"
           Text="A Release wgpu-native copy-local item survived Debug replacement." />
    <Message Importance="high" Text="Verified packed NuGet consumer selected four Debug Android ABI inputs" />
  </Target>
</Project>
