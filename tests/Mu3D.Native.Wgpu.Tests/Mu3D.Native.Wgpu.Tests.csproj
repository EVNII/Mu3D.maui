<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Mu3D.WgpuNativeVersion.props" />
  <Import Project="../../eng/Mu3D.WindowsDxc.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mu3D.Native.Wgpu.Tests</RootNamespace>
    <AssemblyName>Mu3D.Native.Wgpu.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <_Mu3DWindowsNativeTestRuntime Condition="$([MSBuild]::IsOSPlatform('windows'))">$(MSBuildThisFileDirectory)..\..\artifacts\wgpu-native\$(Mu3DWgpuNativeVersion)\release\runtimes\win-x64\native\wgpu_native.dll</_Mu3DWindowsNativeTestRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mu3D.Formats.Gltf/Mu3D.Formats.Gltf.csproj" />
    <ProjectReference Include="../../src/Mu3D.Native.Wgpu/Mu3D.Native.Wgpu.csproj" />
    <ProjectReference Include="../../src/Mu3D.Toolkit/Mu3D.Toolkit.csproj" />
    <None Include="../../samples/GalleryApp/Resources/Raw/GltfSamples/TextureTransformTest/*"
          Link="Assets/TextureTransformTest/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/GalleryApp/Resources/Raw/Hdri/studio_small_02_1k.hdr"
          Link="Assets/studio_small_02_1k.hdr"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(_Mu3DWindowsNativeTestRuntime)"
             Condition="$([MSBuild]::IsOSPlatform('windows')) And Exists('$(_Mu3DWindowsNativeTestRuntime)')">
      <Link>wgpu_native.dll</Link>
      <TargetPath>wgpu_native.dll</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateMu3DWindowsNativeTestRuntime"
          BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <Error Condition="!Exists('$(_Mu3DWindowsNativeTestRuntime)')"
           Text="The Windows native tests require the staged ABI-locked wgpu_native.dll at '$(_Mu3DWindowsNativeTestRuntime)'." />
  </Target>
</Project>
