<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <!-- These probes measure correctness, not compressed download size. -->
    <CompressionEnabled>false</CompressionEnabled>
    <Mu3DWebSuite Condition="'$(Mu3DWebSuite)' == ''">Smoke</Mu3DWebSuite>
    <!-- AOT strips method bodies in intermediate assemblies; never reuse them for interpretation. -->
    <Mu3DWebBuildFlavor>Interpreted</Mu3DWebBuildFlavor>
    <Mu3DWebBuildFlavor Condition="'$(RunAOTCompilation)' == 'true'">Aot</Mu3DWebBuildFlavor>
    <DefineConstants Condition="'$(RunAOTCompilation)' == 'true'">$(DefineConstants);MU3D_WEB_AOT</DefineConstants>
    <Mu3DIncludeBrowserBackend Condition="'$(Mu3DWebSuite)' == 'Render'">true</Mu3DIncludeBrowserBackend>
    <DefineConstants Condition="'$(Mu3DWebSuite)' == 'HostContracts'">$(DefineConstants);MU3D_WEB_CONTRACTS</DefineConstants>
    <EnableMu3DPrinting Condition="'$(EnableMu3DPrinting)' == ''">true</EnableMu3DPrinting>
    <DefineConstants Condition="'$(Mu3DWebSuite)' == 'HostContracts' And '$(EnableMu3DPrinting)' == 'true'">$(DefineConstants);MU3D_PRINTING</DefineConstants>
    <OutputPath>bin/$(Configuration)/$(Mu3DWebSuite)/$(Mu3DWebBuildFlavor)/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(Mu3DWebSuite)/$(Mu3DWebBuildFlavor)/</IntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EmccExtraCFlags Condition="'$(Mu3DWebSuite)' == 'WgpuAbi'">$(EmccExtraCFlags) -I&quot;$(EmdawnWebGpuRoot)/webgpu/include&quot;</EmccExtraCFlags>
    <!-- NativeFileReference C sources are compiled during the final emcc link as well. -->
    <EmccExtraLDFlags Condition="'$(Mu3DWebSuite)' == 'WgpuAbi'">$(EmccExtraLDFlags) -I&quot;$(EmdawnWebGpuRoot)/webgpu/include&quot;</EmccExtraLDFlags>
    <EmccExtraCFlags Condition="'$(Mu3DWebSuite)' == 'Emdawn'">$(EmccExtraCFlags) --use-port=&quot;$(EmdawnWebGpuRoot)/emdawnwebgpu.port.py&quot;</EmccExtraCFlags>
    <EmccExtraLDFlags Condition="'$(Mu3DWebSuite)' == 'Emdawn'">$(EmccExtraLDFlags) --use-port=&quot;$(EmdawnWebGpuRoot)/emdawnwebgpu.port.py&quot;</EmccExtraLDFlags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Mu3D.Core/Mu3D.Core.csproj" />
    <ProjectReference Include="../../src/Mu3D.Creative/Mu3D.Creative.csproj" />
    <Compile Include="Program.cs" Condition="'$(Mu3DWebSuite)' == 'Smoke'" />
    <Compile Include="NativeProbe.cs" Condition="'$(Mu3DWebSuite)' == 'Smoke'" />
    <NativeFileReference Include="mu3d_web_probe.c" Condition="'$(Mu3DWebSuite)' == 'Smoke'" />
    <Compile Include="../Mu3D.Creative.Tests/Program.cs" Link="CreativeTests.cs"
             Condition="'$(Mu3DWebSuite)' == 'Creative'" />
    <Compile Include="../Mu3D.Graphics.Tests/Program.cs" Link="GraphicsTests.cs"
             Condition="'$(Mu3DWebSuite)' == 'Graphics'" />
    <Compile Include="WgpuAbiProbe.cs" Condition="'$(Mu3DWebSuite)' == 'WgpuAbi'" />
    <Compile Include="../../src/Mu3D.Native.Wgpu/Generated/WgpuNative.Raw.g.cs"
             Link="WgpuNative.Raw.g.cs" Condition="'$(Mu3DWebSuite)' == 'WgpuAbi'" />
    <NativeFileReference Include="mu3d_wgpu_abi.c" Condition="'$(Mu3DWebSuite)' == 'WgpuAbi'" />
    <Compile Include="EmdawnProbe.cs" Condition="'$(Mu3DWebSuite)' == 'Emdawn'" />
    <NativeFileReference Include="mu3d_emdawn_probe.c" Condition="'$(Mu3DWebSuite)' == 'Emdawn'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mu3DWebRootCore)' == 'true'">
    <TrimmerRootAssembly Include="Mu3D.Core" />
  </ItemGroup>
  <!-- Run the same host/shared test sources in desktop and WASM; no parallel feature fixture. -->
  <ItemGroup Condition="'$(Mu3DWebSuite)' == 'HostContracts'">
    <Compile Include="../Mu3D.Web.Viewer.Tests/*.cs" Link="HostContracts/%(Filename)%(Extension)" />
    <Compile Include="../Mu3D.Core.Tests/RecordingGraphicsBackend.cs" Link="RecordingGraphicsBackend.cs" />
    <Compile Include="../Mu3D.Toolkit.Tests/SceneNodeAnchorSourceChecks.cs" Link="SceneNodeAnchorSourceChecks.cs" />
    <Compile Include="../../samples/GalleryApp/Web/Infrastructure/NativeGalleryScene.cs;../../samples/GalleryApp/Web/Infrastructure/ProgressGalleryExample.cs;../../samples/GalleryApp/Web/Infrastructure/GalleryPlayable.cs;../../samples/GalleryApp/Examples/SceneAssetExample.cs" Link="Gallery/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../samples/GalleryApp/Pages/*Page.xaml" LogicalName="Mu3D.GalleryApp.NativePages.%(Filename).xaml" />
    <Compile Include="../../samples/GalleryApp/GallerySourceCatalog.cs;../../samples/GalleryApp/GalleryNavigationCatalog.cs;../../samples/GalleryApp/GalleryRoutes.cs;../../samples/GalleryApp/Web/Infrastructure/GalleryWebCatalog.cs" Link="Gallery/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../samples/GalleryApp/Pages/*.cs;../../samples/GalleryApp/Examples/*.cs" Exclude="../../samples/GalleryApp/Pages/CmykPrinting*;../../samples/GalleryApp/Examples/CmykPrintingExample.cs" LogicalName="Mu3D.GalleryApp.Sources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../samples/GalleryApp/Pages/CmykPrinting*.cs;../../samples/GalleryApp/Examples/CmykPrintingExample.cs" Condition="'$(EnableMu3DPrinting)' == 'true'" LogicalName="Mu3D.GalleryApp.Sources.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mu3DWebSuite)' == 'Render' or '$(Mu3DWebSuite)' == 'HostContracts'">
    <ProjectReference Include="../../src/Mu3D.Web.Toolkit/Mu3D.Web.Toolkit.csproj" />
    <Compile Include="../../samples/GalleryApp/Web/Infrastructure/ViewerScene*.cs;../../samples/GalleryApp/Web/Infrastructure/ViewerBenchmark.cs;../../samples/GalleryApp/Web/Infrastructure/SharedValidationScene.cs" />
  </ItemGroup>
  <!-- Source-link the shared adapter; only platform bootstrap and readback differ. -->
  <ItemGroup Condition="'$(Mu3DWebSuite)' == 'Render'">
    <ProjectReference Include="../../src/Mu3D.Rendering.OpenPbr/Mu3D.Rendering.OpenPbr.csproj" />
    <ProjectReference Include="../../src/Mu3D.Formats.MaterialX/Mu3D.Formats.MaterialX.csproj" />
    <Compile Include="RenderProbe.cs;RenderProbe.Benchmark.cs;RenderProbe.Gallery.cs" />
    <Compile Include="../../samples/GalleryApp/Examples/OpenPbrGalleryExample.cs;../../samples/GalleryApp/Pages/OpenPbrTextureExample.cs" Link="Gallery/%(Filename)%(Extension)" />
    <Compile Include="../../samples/GalleryApp/Pages/LightingLabPresenter.cs;../../samples/GalleryApp/Pages/OcclusionLabPresenter.cs" Link="Gallery/%(Filename)%(Extension)" />
    <Compile Include="../../samples/GalleryApp/Web/Infrastructure/BrowserGpu.cs;../../samples/GalleryApp/Web/Infrastructure/RenderSession.cs;../../samples/GalleryApp/Web/Infrastructure/WgpuGraphicsDevice.Browser.cs;../../samples/GalleryApp/Web/Infrastructure/WgpuGraphicsBuffer.Browser.cs" />
  </ItemGroup>
  <Import Project="../../samples/GalleryApp/Web/Infrastructure/BrowserBackend.targets" Condition="'$(Mu3DIncludeBrowserBackend)' == 'true'" />
  <Target Name="ValidateWebSuite" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Mu3DWebSuite)' != 'Smoke' and '$(Mu3DWebSuite)' != 'Creative' and '$(Mu3DWebSuite)' != 'Graphics' and '$(Mu3DWebSuite)' != 'WgpuAbi' and '$(Mu3DWebSuite)' != 'Emdawn' and '$(Mu3DWebSuite)' != 'Render' and '$(Mu3DWebSuite)' != 'HostContracts'"
           Text="Mu3DWebSuite must be Smoke, Creative, Graphics, HostContracts, WgpuAbi, Emdawn or Render." />
    <Error Condition="('$(Mu3DWebSuite)' == 'WgpuAbi' or '$(Mu3DWebSuite)' == 'Emdawn') and !Exists('$(EmdawnWebGpuRoot)/webgpu/include/webgpu/webgpu.h')"
           Text="This suite requires EmdawnWebGpuRoot pointing at the pinned extracted source package." />
  </Target>
</Project>
