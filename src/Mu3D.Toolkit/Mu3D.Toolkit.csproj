    <RootNamespace>Mu3D.Toolkit</RootNamespace>
    <AssemblyName>Mu3D.Toolkit</AssemblyName>
    <PackageId>Mu3D.Toolkit</PackageId>
    <Description>Optional UI-independent viewport controls, gizmos, diagnostics and render features for Mu3D.</Description>
