<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mu3D.Web.Toolkit</RootNamespace>
    <AssemblyName>Mu3D.Web.Toolkit</AssemblyName>
    <PackageId>Mu3D.Web.Toolkit</PackageId>
    <Description>Optional browser input, application-owned scene selection, HTML scene-anchor overlays and frame diagnostics for the portable Mu3D Toolkit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mu3D.Web/Mu3D.Web.csproj" />
    <ProjectReference Include="../Mu3D.Toolkit/Mu3D.Toolkit.csproj" />
    <Content Include="wwwroot/*.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             TargetPath="wwwroot/mu3d/%(Filename)%(Extension)" Pack="true" PackagePath="browser/" />
    <None Include="buildTransitive/Mu3D.Web.Toolkit.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
