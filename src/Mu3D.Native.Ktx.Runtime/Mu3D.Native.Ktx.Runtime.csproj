<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Mu3D.KtxNativeVersion.props" />
  <Import Project="../../eng/Mu3D.RuntimePackage.props" />

  <PropertyGroup>
    <PackageId>Mu3D.Native.Ktx.Runtime</PackageId>
    <Description>Runtime-only, pinned libktx texture-transcoding assets for Mu3D.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../Mu3D.Native.Ktx/THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="../Mu3D.Native.Ktx/licenses/**/*" Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
    <None Include="../Mu3D.Native.Ktx/buildTransitive/Mu3D.Native.Ktx.targets"
          Pack="true"
          PackagePath="buildTransitive/Mu3D.Native.Ktx.targets" />
    <None Update="buildTransitive/Mu3D.Native.Ktx.Runtime.targets"
          Pack="true"
          PackagePath="buildTransitive/Mu3D.Native.Ktx.Runtime.targets" />
    <None Include="../../artifacts/ktx/$(Mu3DKtxNativeVersion)/release/runtimes/**/*"
          Exclude="../../artifacts/ktx/$(Mu3DKtxNativeVersion)/release/runtimes/**/SHA256SUMS*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <_Mu3DRequiredRuntime Include="android-arm/native/libktx.so" />
    <_Mu3DRequiredRuntime Include="android-arm64/native/libktx.so" />
    <_Mu3DRequiredRuntime Include="android-x86/native/libktx.so" />
    <_Mu3DRequiredRuntime Include="android-x64/native/libktx.so" />
    <_Mu3DRequiredRuntime Include="ios-arm64/native/libktx.a" />
    <_Mu3DRequiredRuntime Include="iossimulator-arm64/native/libktx.a" />
    <_Mu3DRequiredRuntime Include="iossimulator-x64/native/libktx.a" />
    <_Mu3DRequiredRuntime Include="maccatalyst-arm64/native/libktx.a" />
    <_Mu3DRequiredRuntime Include="maccatalyst-x64/native/libktx.a" />
    <_Mu3DRequiredRuntime Include="win-arm64/native/ktx.dll" />
    <_Mu3DRequiredRuntime Include="win-x86/native/ktx.dll" />
    <_Mu3DRequiredRuntime Include="win-x64/native/ktx.dll" />
  </ItemGroup>

  <Target Name="ValidateMu3DKtxRuntimePackage" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('../../artifacts/ktx/$(Mu3DKtxNativeVersion)/release/runtimes/%(_Mu3DRequiredRuntime.Identity)')"
           Text="Cannot pack $(PackageId): verified Release runtime '%(_Mu3DRequiredRuntime.Identity)' is missing for $(Mu3DKtxNativeVersion)." />
  </Target>
</Project>
