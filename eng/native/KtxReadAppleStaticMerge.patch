diff --git a/CMakeLists.txt b/CMakeLists.txt
index 632ad8d..cc50d03 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1291,9 +1291,17 @@ macro(set_astc_dependencies target)
     if(NOT BUILD_SHARED_LIBS AND APPLE)
