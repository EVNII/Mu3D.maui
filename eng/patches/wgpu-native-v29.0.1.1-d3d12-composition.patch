diff --git a/src/lib.rs b/src/lib.rs
index ba92673..93d7029 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -2688,0 +2689,40 @@ pub unsafe extern "C" fn wgpuDeviceGetNativeMetalDevice(device: native::WGPUDevi
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeD3D12Device(
+    device: native::WGPUDevice,
+) -> *mut c_void {
+    #[cfg(all(target_os = "windows", feature = "dx12"))]
+    {
+        let device = device.as_ref().expect("invalid device");
+        let hal_device = device.context.device_as_hal::<hal::api::Dx12>(device.id);
+        if let Some(hal_device) = hal_device {
+            return windows_core::Interface::as_raw(hal_device.raw_device()) as *mut c_void;
+        }
+        std::ptr::null_mut()
+    }
+    #[cfg(not(all(target_os = "windows", feature = "dx12")))]
+    {
+        let _ = device;
+        std::ptr::null_mut()
+    }
+}
+
