@page "/about"
@page "/licenses"
@inject NavigationManager Navigation
@using Mu3D.GalleryApp.Web.Infrastructure

<main><a href="">Mu3D Gallery</a>
    @foreach (string text in GalleryWebCatalog.PageText(IsLicenses ? "LicensesPage" : "AboutPage")) { <p>@text</p> }
    @if (!IsLicenses) { <a href="licenses">Licenses and acknowledgements</a> }
    else
    {
        <p><a href="assets/AboutAssets.txt">Gallery asset notices</a> ·
            <a href="assets/GltfSamples/README.md">glTF notices</a> ·
            <a href="assets/Hdri/README.md">HDRI notices</a></p>
    }
</main>
@code { private bool IsLicenses => Navigation.Uri.EndsWith("/licenses", StringComparison.Ordinal); }
