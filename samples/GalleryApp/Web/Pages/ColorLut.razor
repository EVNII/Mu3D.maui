@page "/examples/color-lut"
@implements IAsyncDisposable
@using Mu3D.GalleryApp.Examples
@using Mu3D.Graphics

<main><a href="">返回 Gallery</a><h1>GPU Color LUT</h1>
<a href="https://evnii.github.io/Mu3D.maui/v0.1/articles/features/color-lut.html" target="_blank" rel="noopener">示例文档</a>
<p>A 3D color table transforms an HDR linear-sRGB ramp and color patches.</p>
<div class="controls"><label><input type="checkbox" @bind="enabled" @bind:after="Invalidate" />Apply color LUT</label>
<label>LUT exposure: @exposure.ToString("+0.0;-0.0;0.0") stops <input type="range" min="-2" max="2" step="0.1" @bind="exposure" @bind:event="oninput" @bind:after="Invalidate" /></label></div>
<GalleryCanvas @ref="canvas" Title="GPU Color LUT" Draw="Draw" Disconnected="example.Dispose" />
<p style="white-space:pre-wrap">@status</p></main>

@code {
    private readonly ColorLutExample example = new();
    private GalleryCanvas? canvas;
    private bool enabled = true, disposed;
    private float exposure = 0;
    private string status = "Waiting for an extended-linear HDR surface…";
    private async Task Invalidate()
    { example.Enabled = enabled; example.ExposureStops = exposure; if (canvas is not null) await canvas.InvalidateAsync(); }
    private void Draw(GraphicsDevice device, GraphicsTexture target, GraphicsTexture? depth, double delta)
    {
        string next = example.Draw(device, target);
        if (!disposed && next != status) { status = next; _ = InvokeAsync(StateHasChanged); }
    }
    /// <inheritdoc />
    public async ValueTask DisposeAsync() { disposed = true; if (canvas is not null) await canvas.DisposeAsync(); example.Dispose(); }
}
