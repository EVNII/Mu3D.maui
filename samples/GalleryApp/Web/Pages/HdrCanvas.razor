@page "/examples/hdr-canvas"
@implements IAsyncDisposable
@using Mu3D.GalleryApp.Examples
@using Mu3D.GalleryApp.Web.Infrastructure
@using Mu3D.Graphics
@using Mu3D.Rendering
@using Mu3D.SceneGraph

<main><a href="">返回 Gallery</a><h1>HDR Canvas</h1>
<a href="https://evnii.github.io/Mu3D.maui/v0.1/articles/features/hdr-canvas.html" target="_blank" rel="noopener">示例文档</a>
<p>Linear HDR canvas → scene texture</p><GalleryCanvas @ref="viewport" Title="HDR Canvas" Draw="Draw" Disconnected="Release" />
<div class="controls"><button @onclick="AddDab">Add HDR dab</button><button @onclick="Reset">Reset</button></div><p>@status</p></main>

@code {
    private readonly HdrCanvasExample example = new();
    private readonly NativeGalleryScene scene = NativeGalleryScene.Read("HdrCanvasPage");
    private SceneRenderer? renderer;
    private GalleryCanvas? viewport;
    private string status = "";
    protected override void OnInitialized() { example.Reset(); Publish(); }
    private async Task AddDab() { example.AddDab(); Publish(); if (viewport is not null) await viewport.InvalidateAsync(); }
    private async Task Reset() { example.Reset(); Publish(); if (viewport is not null) await viewport.InvalidateAsync(); }
    private void Publish() => ((UnlitMaterial)scene.NamedMaterials["CanvasMaterial"]).BaseColorTexture = example.Publish(out status);
    private void Draw(GraphicsDevice device, GraphicsTexture target, GraphicsTexture? depth, double delta)
    {
        renderer ??= new(device, target.Descriptor.Format);
        scene.Camera.AspectRatio = (float)target.Descriptor.Size.Width / target.Descriptor.Size.Height;
        renderer.Render(scene.Scene, scene.Camera, target, depth!);
    }
    private void Release() { renderer?.Dispose(); renderer = null; }
    /// <inheritdoc />
    public async ValueTask DisposeAsync() { if (viewport is not null) await viewport.DisposeAsync(); Release(); }
}
