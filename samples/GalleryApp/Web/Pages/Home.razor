@page "/"
@page "/examples"
@page "/examples/gallery-overview"
@using Mu3D.GalleryApp
@using Mu3D.GalleryApp.Web.Infrastructure

<header><h1>GalleryApp · Web</h1><p>原生 MAUI Gallery 的 WebAssembly 移植</p></header>
<main>
    @foreach (string text in GalleryWebCatalog.PageText("WelcomePage")) { <p>@text</p> }
    <p>Web 使用同一套 Mu3D 核心、渲染器和示例资源，Razor 提供浏览器控件。</p>
    <div class="example-catalog">
    @foreach (GalleryExample example in GalleryNavigationCatalog.Examples)
    {
        <article><h2><NavLink href="@($"examples/{GalleryWebCatalog.FeatureId(example)}")">@example.Title</NavLink></h2>
        <p>@example.Description</p><a href="@($"source/{GalleryWebCatalog.FeatureId(example)}")">Source</a></article>
    }
    </div>
    <h2>Advanced</h2>
    <a href="examples/material-conformance">Material Conformance</a>
    <a href="source/material-conformance">Source</a>
    <p><a href="about">About</a> · <a href="licenses">Licenses and acknowledgements</a></p>
</main>
