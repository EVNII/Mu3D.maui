@page "/examples/skinning-animation"
@implements IAsyncDisposable
@using Mu3D.Graphics
@using Mu3D.GalleryApp.Pages

<main>
    <a href="">返回 Gallery</a>
    <h1>Skinning + Animation</h1>
    <a href="https://evnii.github.io/Mu3D.maui/v0.1/articles/features/skinning-animation.html" target="_blank" rel="noopener">示例文档</a>
    <p>原生 Animation Lab 的同一双关节 FP32 skin、两个混合 clip 和蒙皮前 morph target；16 段 strip、4 个 FP32 权重及位置/法线 palette 全部共用。</p>
    <GalleryCanvas @ref="viewport" Title="Animation Lab" Draw="Draw" Continuous="play" Disconnected="Release" />
    <div class="controls">
        <label><input type="checkbox" @bind="play" @bind:after="Refresh" /> Play loop</label>
        <label>Time @time.ToString("0.00") s <input type="range" min="0" max="2" step="0.01" @bind="time" @bind:event="oninput" @bind:after="Refresh" /></label>
        <label>Speed @speed.ToString("0.00")× <input type="range" min="0.1" max="2" step="0.01" @bind="speed" @bind:event="oninput" @bind:after="Refresh" /></label>
        <label>Clip B blend @blend.ToString("0.00") <input type="range" min="0" max="1" step="0.01" @bind="blend" @bind:event="oninput" @bind:after="Refresh" /></label>
        <label>Morph weight @morph.ToString("0.00") <input type="range" min="-0.5" max="1.5" step="0.01" @bind="morph" @bind:event="oninput" @bind:after="Refresh" /></label>
        <button @onclick="Reset">Reset animation</button>
    </div>
    <p>可见、阴影和 AO 深度路径共用变形；本示例与原生一样绘制可见路径。Canvas 使用 FP16 HDR，保持最终输出边界。</p>
</main>

@code {
    private GalleryCanvas? viewport;
    private AnimationLabPresenter? presenter;
    private bool play = true, disposed;
    private float time, speed = 1, blend, morph;
    private double elapsedPublication;
    private void Draw(GraphicsDevice device, GraphicsTexture target, GraphicsTexture? depth, double delta)
    {
        if (disposed) return;
        presenter ??= new();
        if (play) time = (time + (float)delta * speed) % presenter.Duration;
        presenter.Blend = blend; presenter.MorphWeight = morph;
        presenter.Draw(device, target, depth!, time);
        elapsedPublication += delta;
        if (elapsedPublication >= .1) { elapsedPublication = 0; _ = InvokeAsync(StateHasChanged); }
    }
    private Task Refresh() => !disposed && viewport is not null ? viewport.InvalidateAsync() : Task.CompletedTask;
    private async Task Reset() { time = blend = morph = 0; speed = 1; await Refresh(); }
    private void Release() { presenter?.Dispose(); presenter = null; }
    public async ValueTask DisposeAsync() { disposed = true; if (viewport is not null) await viewport.DisposeAsync(); Release(); }
}
