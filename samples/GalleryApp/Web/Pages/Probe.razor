@page "/examples/device-probe"
@page "/examples/surface-probe"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using Mu3D.Graphics
@using Mu3D.Native.Wgpu
@using Mu3D.GalleryApp.Web.Infrastructure

<main>
    <a href="">返回 Gallery</a>
    <h1>@(surfacePage ? "Surface Probe" : "Device Probe")</h1>
    <a href="@($"https://evnii.github.io/Mu3D.maui/v0.1/articles/features/{(surfacePage ? "surface-probe" : "device-probe")}.html")" target="_blank" rel="noopener">示例文档</a>
    @if (surfacePage)
    {
        <p>与原生 Surface Probe 共用同一参考图案：上半部 0–4 灰阶，下半部 0 / 0.18 / 0.5 / 1 / 2 / 4。</p>
        <div class="controls">
            <button disabled="@(session is null)" @onclick="InspectSurface">Probe surface capabilities</button>
            <button disabled="@(session is null)" @onclick="PresentPattern">Present reference pattern</button>
            <label>曝光 <input type="range" min="-4" max="2" step="0.25" @bind="exposure" @bind:event="oninput" @bind:after="SettingsChanged" /> @exposure.ToString("0.00") EV</label>
            <label>输出 <select @bind="OutputMode" @bind:after="SettingsChanged"><option value="hdr">HDR</option><option value="sdr">SDR 预览</option></select></label>
        </div>
        <canvas id="mu3d-canvas" @ref="canvas" tabindex="0" aria-label="Surface reference pattern"></canvas>
        <p>参考数据为 extended-linear sRGB；Canvas 在最终输出处编码为 extended sRGB。浏览器配置成功不证明物理 HDR 亮度。</p>
    }
    else
    {
        <p>创建临时 WebGPU 适配器和设备，读取实际功能与限制，并创建 RGBA16Float 纹理。浏览器隐藏的信息显示为不可用。</p>
        <button disabled="@running" @onclick="() => RunProbe(false)">Run device probe</button>
        <p role="status">@deviceStatus</p>
        <pre style="white-space:pre-wrap;overflow-wrap:anywhere">@deviceDetails</pre>
        <h2>M2 Offscreen Triangle Probe</h2>
        <p>与原生共用 32×32 FP16 三角形、WGSL 和 Mu3D Graphics 命令；异步观察队列完成并读取中心像素。离屏结果不证明 Surface 或物理 HDR。</p>
        <button disabled="@running" @onclick="() => RunProbe(true)">Run offscreen triangle probe</button>
        <p role="status">@triangleStatus</p>
        <pre style="white-space:pre-wrap;overflow-wrap:anywhere">@triangleDetails</pre>
        @if (running) { <p role="status">正在等待 GPU…</p> }
    }
    @if (surfacePage)
    {
        <p class="status" role="status">@surfaceStatus</p>
        <pre style="white-space:pre-wrap;overflow-wrap:anywhere">@surfaceDetails</pre>
    }
</main>

@code {
    private RenderSession? session;
    private IJSObjectReference? module, host;
    private DotNetObjectReference<Probe>? reference;
    private ElementReference canvas;
    private Task? startup, probe;
    private bool initialized, surfacePage, disposed, running, patternPresented;
    private bool hdr = true;
    private string OutputMode { get => hdr ? "hdr" : "sdr"; set => hdr = value switch { "hdr" => true, "sdr" => false, _ => hdr }; }
    private double exposure = 0;
    private string surfaceStatus = "Waiting for a Canvas surface…", surfaceDetails = "";
    private string deviceStatus = "Not run", deviceDetails = "", triangleStatus = "Not run", triangleDetails = "";

    protected override async Task OnParametersSetAsync()
    {
        bool next = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/').EndsWith("surface-probe", StringComparison.Ordinal);
        if (initialized && next != surfacePage)
        {
            if (probe is not null) await probe;
            await StopSurfaceAsync();
        }
        surfacePage = next;
        initialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (surfacePage && startup is null && !disposed) { startup = StartSurfaceAsync(); await startup; }
    }

    private async Task StartSurfaceAsync()
    {
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./gallery-viewport.mjs");
            if (disposed) return;
            session = await RenderSession.OpenAsync();
            if (disposed) return;
            reference = DotNetObjectReference.Create(this);
            host = await module.InvokeAsync<IJSObjectReference>("create", canvas, reference, session.MaximumDimension);
            await SettingsChanged();
        }
        catch (Exception error) { if (!disposed) { surfaceStatus = "Surface initialization failed"; surfaceDetails = error.ToString(); await InvokeAsync(StateHasChanged); } }
    }

    private async Task SettingsChanged()
    {
        if (host is not null && !disposed) await host.InvokeVoidAsync("configure", false, false, hdr);
    }

    private void InspectSurface()
    {
        if (session is null) return;
        surfaceStatus = session.PresentationSurface.Width == 0 ? "Canvas configuration pending" : "Canvas surface configured";
        surfaceDetails = FormatSurface();
    }

    private async Task PresentPattern() { patternPresented = true; await SettingsChanged(); }

    /// <summary>Submits the exact shared native reference stimulus through the Canvas output boundary.</summary>
    [JSInvokable]
    public async Task DrawFrame(int width, int height, double delta, double interval, double pixelRatio,
        double logicalWidth, double logicalHeight, float rotateX, float rotateY, float dolly, bool outputHdr, bool refresh)
    {
        if (disposed || session is null) return;
        await session.DrawExampleAsync(width, height, (float)exposure, outputHdr, refresh, (device, target, _) =>
        {
            if (patternPresented) WgpuReferencePatternRenderer.Render(device, target);
            else
            {
                using GraphicsCommandEncoder encoder = device.CreateCommandEncoder("surface-probe clear");
                using (GraphicsRenderPassEncoder pass = encoder.BeginRenderPass(new(new GraphicsRenderPassColorAttachment(target, clearColor: new(0, 0, 0, 1))))) { }
                using GraphicsCommandBuffer commands = encoder.Finish();
                device.Queue.Submit(commands);
            }
        });
        string next = FormatSurface();
        if (surfaceDetails != next)
        {
            surfaceStatus = patternPresented ? "Reference pattern submitted" : "Canvas surface ready";
            surfaceDetails = next;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string FormatSurface()
    {
        if (session is null) return "Surface unavailable";
        IPresentationSurfaceSession surface = session.PresentationSurface;
        DisplayHdrInfo display = surface.QueryDisplayHdrInfo();
        return $"Extent: {surface.Width} x {surface.Height} physical pixels\nFormat: {surface.OutputPlan.Output.Format}\n" +
            $"Dynamic range: {surface.OutputPlan.Output.DynamicRange}\nColor encoding: {surface.OutputPlan.Output.Encoding}\n" +
            $"Configuration headroom: {Optional(surface.OutputPlan.Output.HdrHeadroom)}\nLive display headroom: {Optional(display.ToneMapHeadroom)}\n" +
            $"Display HDR metadata: {(display.IsUnknown ? "unavailable" : "available")}\nFallback: {surface.OutputPlan.Output.FallbackReason ?? "none"}\n" +
            $"API-permitted formats: {string.Join(", ", surface.Capabilities.Formats)}\nPresent modes: {string.Join(", ", surface.Capabilities.PresentModes)}\n" +
            "Capability source: Emdawn/WebGPU API contract; hardware/display HDR is not inferred\nPhysical HDR output verified: false";
    }

    private static string Optional(float? value) => value is float known ? $"{known:0.###}x" : "unknown";

    private async Task RunProbe(bool triangle)
    {
        if (running || disposed) return;
        running = true;
        probe = RunProbeCore(triangle);
        await probe;
    }

    private async Task RunProbeCore(bool triangle)
    {
        try
        {
            if (triangle) { triangleStatus = "Submitting offscreen triangle…"; triangleDetails = ""; }
            else { deviceStatus = "Probing browser adapter and device…"; deviceDetails = ""; }
            string result = await (triangle ? BrowserGpu.ProbeTriangleAsync() : BrowserGpu.ProbeDeviceAsync());
            if (disposed) return;
            if (triangle) { triangleStatus = "Offscreen triangle completed"; triangleDetails = result; }
            else { deviceStatus = "Device probe completed"; deviceDetails = result; }
        }
        catch (Exception error)
        {
            if (disposed) return;
            if (triangle) { triangleStatus = "Offscreen triangle failed"; triangleDetails = error.ToString(); }
            else { deviceStatus = "Device probe failed"; deviceDetails = error.ToString(); }
        }
        finally { running = false; if (!disposed) await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Reports stopped surface rendering without silently selecting SDR.</summary>
    [JSInvokable] public Task RenderFailed(string message) { if (disposed) return Task.CompletedTask; surfaceStatus = "Surface presentation failed"; surfaceDetails = message; return InvokeAsync(StateHasChanged); }
    /// <summary>Releases resources only after the viewport handler has settled.</summary>
    [JSInvokable] public void Disconnect() { session?.Dispose(); session = null; patternPresented = false; }

    private async Task StopSurfaceAsync()
    {
        if (startup is not null) await startup;
        if (host is not null) { await host.InvokeVoidAsync("dispose"); await host.DisposeAsync(); host = null; }
        Disconnect(); reference?.Dispose(); reference = null;
        if (module is not null) { await module.DisposeAsync(); module = null; }
        startup = null;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (probe is not null) await probe;
        await StopSurfaceAsync();
    }
}
