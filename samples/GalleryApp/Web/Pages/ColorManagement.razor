@page "/examples/color-management"
@implements IAsyncDisposable
@using Mu3D.Color
@using Mu3D.Graphics
@using Mu3D.Rendering
@using Mu3D.GalleryApp.Pages
@using Mu3D.GalleryApp.Web.Infrastructure

<main><a href="">返回 Gallery</a><h1>Standard、AgX、ACES 2.0 与 Filmic</h1>
<a href="https://evnii.github.io/Mu3D.maui/v0.1/articles/features/color-management.html" target="_blank" rel="noopener">示例文档</a>
<div class="controls">
<label>测试场景 <select @bind="sceneChoice" @bind:after="Rebuild"><option value="0">RGB / CMY / 白色色带</option><option value="1">连续色相色带</option><option value="2">3D 高光球体</option></select></label>
<label>比较输出 <select @bind="range" @bind:after="Rebuild"><option value="0">HDR · 1000 nit · P3 D65</option><option value="1">SDR · 100 nit · Rec.709</option></select></label>
<label>曝光 @exposure.ToString("+0.0;-0.0;0.0") EV（共用） <input type="range" min="-6" max="6" step="0.1" @bind="exposure" @bind:event="oninput" @bind:after="Invalidate" /></label>
@if (sceneChoice == 2)
{ <label>3D 视图 <select @bind="sceneView" @bind:after="Invalidate"><option value="0">AgX</option><option value="1">ACES 2.0</option></select></label> }
else
{ <label>色带饱和度 @saturation.ToString("P0") <input type="range" min="0" max="1" step="0.01" @bind="saturation" @bind:event="oninput" @bind:after="Invalidate" /></label> }
</div>
@if (sceneChoice == 2)
{ <p>同一组材质和灯光，切换 AgX / ACES 2.0；HDR 模式共享 P3 1000 nit 输出条件。</p> }
else
{
    <p>各栏共用线性 Rec.2020 输入、曝光与饱和度。Standard 只做显示转换，不压缩高光；不同于 Blender 的 Raw 数值检查。AgX 与 ACES 的输出条件一致。SDR 比较加入 Blender 原版 Filmic（无额外 Look）。</p>
    <p>@(sceneChoice == 1 ? "从上到下连续改变色相，左暗右亮。观察高亮色相带是否连续。" : "从上到下：红 R、绿 G、蓝 B、青 C、品红 M、黄 Y、白。每行通道峰值相同，亮度 Y 不相同。")</p>
}
<GalleryCanvasGroup @key="generation" @ref="group" Panels="panels" Hdr="@(range == 0)" Disconnected="Release" />
@if (sceneChoice != 2)
{
    <p>−6 → −3 → 0 → +3 → +6 → +9 → +12 档。横轴 0 档的通道峰值为 0.18；未加曝光时范围约 0.0028–737.28。饱和度 0% 时全部变成中性灰。</p>
    <p>@(range == 0 ? "Standard 保留原始线性值，极端曝光超出 ±65504 时截断。" : "Standard 直接裁切到 0–1，无高光压缩。") AgX / ACES / Filmic 的参考白为 100 nit。</p>
}
<p>ACES 2.0 已采用新的亮度、色度与色域压缩。HDR 的实际高光亮度取决于显示器余量；不支持 HDR 时请显式选择 SDR 比较。</p></main>

@code {
    private readonly ColorComparisonRenderer?[] comparisons = new ColorComparisonRenderer?[4];
    private readonly NativeGalleryScene scene = NativeGalleryScene.Read("ColorManagementPage");
    private GalleryCanvasGroup? group;
    private GalleryCanvasPanel[] panels = [];
    private SceneRenderer? sceneRenderer;
    private GraphicsTexture? sceneSource;
    private ColorViewGpuTransform? display;
    private int sceneChoice, sceneView, range, generation;
    private float exposure, saturation = 1;
    private bool disposed;
    protected override void OnInitialized() => BuildPanels();
    private ColorViewPreset Preset(bool aces) => range == 0
        ? aces ? ColorViewPreset.Aces2Hdr1000P3 : ColorViewPreset.AgXHdr1000
        : aces ? ColorViewPreset.Aces2Sdr : ColorViewPreset.AgXSdr;
    private void BuildPanels()
    {
        string output = range == 0 ? "HDR 1000 nit · P3 D65" : "SDR 100 nit · Rec.709";
        panels = sceneChoice == 2 ? [new("3D 高光球体", DrawScene)] :
            [new(range == 0 ? "Standard · HDR 直出" : "Standard · SDR 硬裁切", (d,t,z,dt) => DrawComparison(0,d,t)),
             new("AgX · " + output, (d,t,z,dt) => DrawComparison(1,d,t)),
             new("ACES 2.0 · " + output, (d,t,z,dt) => DrawComparison(2,d,t))];
        if (sceneChoice != 2 && range == 1)
            panels = [.. panels, new("Filmic · SDR 100 nit · Rec.709 · 无 Look", (d,t,z,dt) => DrawComparison(3,d,t))];
    }
    private async Task Rebuild()
    {
        int count = sceneChoice == 2 ? 1 : range == 0 ? 3 : 4;
        if (panels.Length == count) { BuildPanels(); await Invalidate(); return; }
        if (group is not null) await group.DisposeAsync();
        group = null; Release(); generation++; BuildPanels();
    }
    private async Task Invalidate() { if (group is not null) await group.InvalidateAsync(); }
    private void DrawComparison(int index, GraphicsDevice device, GraphicsTexture target)
    {
        var renderer = comparisons[index] ??= new(device);
        if (index == 0) renderer.DrawStandard(target, exposure, saturation, sceneChoice == 1, range == 0, ColorEncoding.ExtendedSrgbLinear);
        else renderer.Draw(target, index == 3 ? ColorViewPreset.FilmicSdr : Preset(index == 2), exposure,
            saturation, sceneChoice == 1, ColorEncoding.ExtendedSrgbLinear);
    }
    private void DrawScene(GraphicsDevice device, GraphicsTexture target, GraphicsTexture? depth, double delta)
    {
        var size = target.Descriptor.Size;
        sceneRenderer ??= new(device, target.Descriptor.Format);
        if (sceneSource?.Descriptor.Size != size)
        {
            sceneSource?.Dispose();
            sceneSource = device.CreateTexture(new(size, target.Descriptor.Format,
                GraphicsTextureUsage.RenderAttachment | GraphicsTextureUsage.TextureBinding, label: "Gallery highlight scene"));
        }
        scene.Camera.AspectRatio = (float)size.Width / size.Height;
        sceneRenderer.Render(scene.Scene, scene.Camera, sceneSource, depth!);
        var transform = new ColorViewTransform(Preset(sceneView == 1), StandardColorSpaces.LinearSrgb, exposure, 100);
        if (display is null || display.Transform.Preset != transform.Preset)
        { display?.Dispose(); display = new(device, transform, target.Descriptor.Format, ColorEncoding.ExtendedSrgbLinear); }
        else display.UpdateTransform(transform);
        display.Apply(sceneSource, StandardColorSpaces.LinearSrgb, target, StandardColorSpaces.LinearSrgb);
    }
    private void Release()
    {
        foreach (var renderer in comparisons) renderer?.Dispose(); Array.Clear(comparisons);
        display?.Dispose(); display = null; sceneSource?.Dispose(); sceneSource = null;
        sceneRenderer?.Dispose(); sceneRenderer = null;
    }
    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    { if (disposed) return; disposed = true; if (group is not null) await group.DisposeAsync(); Release(); }
}
