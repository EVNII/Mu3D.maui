@inject NavigationManager Navigation
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="route"><RouteView @key="Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]" RouteData="@route" /></Found>
    <NotFound><h1>页面不存在</h1><a href="">返回 Gallery</a></NotFound>
</Router>

