<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Web/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Web/**" />
    <MauiXaml Remove="Web/**" />
    <Content Remove="Web/**" />
    <None Remove="Web/**" />
  </ItemGroup>
  <Import Project="../../eng/Mu3D.WgpuNativeVersion.props" />
  <Import Project="../../eng/Mu3D.WindowsDxc.targets" />
  <Import Project="../../eng/Mu3D.UltraHdrNativeVersion.props" />
  <Import Project="../../src/Mu3D.Native.UltraHdr/buildTransitive/Mu3D.Native.UltraHdr.Symbols.props" />
  <Import Project="../../eng/Mu3D.KtxNativeVersion.props" />

  <!-- Gallery opts into the optional printing example. Library consumers never inherit this switch. -->
  <PropertyGroup>
    <EnableMu3DPrinting Condition="'$(EnableMu3DPrinting)' == ''">true</EnableMu3DPrinting>
    <DefineConstants Condition="'$(EnableMu3DPrinting)' == 'true'">$(DefineConstants);MU3D_PRINTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableMu3DPrinting)' == 'true'">
    <ProjectReference Include="../../src/Mu3D.Color.Printing/Mu3D.Color.Printing.csproj" />
    <!-- Optional local test inputs; no third-party profiles are stored in this repository. -->
    <MauiAsset Include="$(Mu3DPrintProfileDirectory)/*.icc" LogicalName="PrintProfiles/%(Filename)%(Extension)"
               Condition="'$(Mu3DPrintProfileDirectory)' != ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableMu3DPrinting)' != 'true'">
    <Compile Remove="Pages/CmykPrinting*.cs;Examples/CmykPrintingExample.cs" />
    <MauiXaml Remove="Pages/CmykPrintingPage.xaml" />
  </ItemGroup>

  <!-- Workload set 10.0.401 contains both the Xcode 26.6 SDK and the opt-in Xcode 27 SDK.
       Select the latter for this app without raising the public libraries' platform baseline
       or changing the existing `-f net10.0-maccatalyst` launch command. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <TargetPlatformVersion>27.0</TargetPlatformVersion>
    <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
  </PropertyGroup>

  <!-- The Xcode 27 preview SDK omits AppBundleManifest from this target's file inputs.
       Track it explicitly so scene/lifecycle edits invalidate the generated Info.plist. -->
  <Target Name="TrackMacCatalystAppManifest"
          AfterTargets="_CompileAppManifestInputs"
          BeforeTargets="_CompileAppManifest"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(TargetPlatformVersion)' == '27.0'">
    <ItemGroup>
      <_CompileAppManifestInputFile Include="$(AppBundleManifest)" Condition="Exists('$(AppBundleManifest)')" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Note for Mac Catalyst:
         The default runtime is maccatalyst-x64, except in Release, where the default is
         maccatalyst-x64;maccatalyst-arm64. Use RuntimeIdentifiers when specifying both.
         The Mac App Store requires either both runtimes or only maccatalyst-x64. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Mu3D.GalleryApp</RootNamespace>
    <AssemblyName>Mu3D.GalleryApp</AssemblyName>
    <IsPackable>false</IsPackable>
    <UseMaui>true</UseMaui>
    <!-- Official MAUI project-level opt-in. MAUI applies it only to Android; Apple and Windows
         retain their native platform controls. -->
    <UseMaterial3>true</UseMaterial3>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MAUI generates public resource-dictionary helpers without XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ApplicationTitle>GalleryApp</ApplicationTitle>
    <ApplicationId>com.mu3d.gallery</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <!-- The Xcode 27 SDK requires Mac Catalyst 17.0 or later for applications. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <Mu3DEnableDeviceHarness Condition="'$(Mu3DEnableDeviceHarness)' == ''">false</Mu3DEnableDeviceHarness>
    <Mu3DUseRuntimePackages Condition="'$(Mu3DUseRuntimePackages)' == ''">false</Mu3DUseRuntimePackages>
    <Mu3DUltraHdrEnableHeif Condition="'$(Mu3DUltraHdrEnableHeif)' == ''">false</Mu3DUltraHdrEnableHeif>
    <Mu3DDocumentationBaseUrl Condition="'$(Mu3DDocumentationBaseUrl)' == '' And '$(Configuration)' == 'Debug'">http://localhost:8080/v0.1/</Mu3DDocumentationBaseUrl>
    <Mu3DDocumentationBaseUrl Condition="'$(Mu3DDocumentationBaseUrl)' == ''">https://evnii.github.io/Mu3D.maui/v0.1/</Mu3DDocumentationBaseUrl>
    <_Mu3DUltraHdrNativeConfiguration Condition="'$(Mu3DUltraHdrEnableHeif)' != 'true'">release</_Mu3DUltraHdrNativeConfiguration>
    <_Mu3DUltraHdrNativeConfiguration Condition="'$(Mu3DUltraHdrEnableHeif)' == 'true'">release-heif</_Mu3DUltraHdrNativeConfiguration>
    <_Mu3DDeviceHarnessEnabled Condition="'$(Mu3DEnableDeviceHarness)' == 'true' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</_Mu3DDeviceHarnessEnabled>
    <_Mu3DDeviceHarnessRuntimeRoot>$(MSBuildThisFileDirectory)..\..\artifacts\wgpu-native\$(Mu3DWgpuNativeVersion)\release\runtimes</_Mu3DDeviceHarnessRuntimeRoot>
    <_Mu3DUltraHdrRuntimeRoot>$(MSBuildThisFileDirectory)..\..\artifacts\ultrahdr\$(Mu3DUltraHdrNativeVersion)\$(_Mu3DUltraHdrNativeConfiguration)\runtimes</_Mu3DUltraHdrRuntimeRoot>
    <_Mu3DKtxRuntimeRoot>$(MSBuildThisFileDirectory)..\..\artifacts\ktx\$(Mu3DKtxNativeVersion)\release\runtimes</_Mu3DKtxRuntimeRoot>
    <!-- A plain multi-target `dotnet run` evaluates this property in the outer build before the
         Mac Catalyst workload supplies RuntimeIdentifier to its inner build. Derive the local Mac
         RID from the SDK host RID so the optional native archive decision is identical to an
         invocation with an explicit Mac Catalyst runtime argument. -->
    <_Mu3DDefaultMacCatalystRuntimeIdentifier Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">maccatalyst-arm64</_Mu3DDefaultMacCatalystRuntimeIdentifier>
    <_Mu3DDefaultMacCatalystRuntimeIdentifier Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">maccatalyst-x64</_Mu3DDefaultMacCatalystRuntimeIdentifier>
    <_Mu3DKtxRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Mu3DKtxRuntimeIdentifier>
    <_Mu3DKtxRuntimeIdentifier Condition="'$(_Mu3DKtxRuntimeIdentifier)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(_Mu3DDefaultMacCatalystRuntimeIdentifier)</_Mu3DKtxRuntimeIdentifier>
    <_Mu3DUltraHdrRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_Mu3DUltraHdrRuntimeIdentifier>
    <_Mu3DUltraHdrRuntimeIdentifier Condition="'$(_Mu3DUltraHdrRuntimeIdentifier)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(_Mu3DDefaultMacCatalystRuntimeIdentifier)</_Mu3DUltraHdrRuntimeIdentifier>
    <!-- Gallery is a diagnostic app: when a verified Apple archive is locally staged, link it by
         default so the visible KTX page cannot run against a half-enabled managed-only build. -->
    <Mu3DEnableKtxHarness Condition="'$(Mu3DEnableKtxHarness)' == '' And '$(Mu3DUseRuntimePackages)' == 'true'">true</Mu3DEnableKtxHarness>
    <Mu3DEnableKtxHarness Condition="'$(Mu3DEnableKtxHarness)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And Exists('$(_Mu3DKtxRuntimeRoot)\android-arm64\native\libktx.so')">true</Mu3DEnableKtxHarness>
    <Mu3DEnableKtxHarness Condition="'$(Mu3DEnableKtxHarness)' == '' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') And '$(_Mu3DKtxRuntimeIdentifier)' != '' And Exists('$(_Mu3DKtxRuntimeRoot)\$(_Mu3DKtxRuntimeIdentifier)\native\libktx.a')">true</Mu3DEnableKtxHarness>
    <_Mu3DWindowsRuntimeRid Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(RuntimeIdentifier)' == 'win10-arm64'">win-arm64</_Mu3DWindowsRuntimeRid>
    <_Mu3DWindowsRuntimeRid Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win10-x86'">win-x86</_Mu3DWindowsRuntimeRid>
    <_Mu3DWindowsRuntimeRid Condition="'$(_Mu3DWindowsRuntimeRid)' == ''">win-x64</_Mu3DWindowsRuntimeRid>
    <Mu3DEnableKtxHarness Condition="'$(Mu3DEnableKtxHarness)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And Exists('$(_Mu3DKtxRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\ktx.dll')">true</Mu3DEnableKtxHarness>
    <Mu3DEnableKtxHarness Condition="'$(Mu3DEnableKtxHarness)' == ''">false</Mu3DEnableKtxHarness>
    <_Mu3DWindowsRuntimeFile>$(_Mu3DDeviceHarnessRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\wgpu_native.dll</_Mu3DWindowsRuntimeFile>
    <Mu3DEnableUltraHdrHarness Condition="'$(Mu3DEnableUltraHdrHarness)' == '' And '$(Mu3DUseRuntimePackages)' == 'true'">true</Mu3DEnableUltraHdrHarness>
    <Mu3DEnableUltraHdrHarness Condition="'$(Mu3DEnableUltraHdrHarness)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-arm64\native\libuhdr.so')">true</Mu3DEnableUltraHdrHarness>
    <Mu3DEnableUltraHdrHarness Condition="'$(Mu3DEnableUltraHdrHarness)' == '' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') And '$(_Mu3DUltraHdrRuntimeIdentifier)' != '' And Exists('$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libuhdr.a')">true</Mu3DEnableUltraHdrHarness>
    <Mu3DEnableUltraHdrHarness Condition="'$(Mu3DEnableUltraHdrHarness)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And Exists('$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\uhdr.dll')">true</Mu3DEnableUltraHdrHarness>
    <Mu3DEnableUltraHdrHarness Condition="'$(Mu3DEnableUltraHdrHarness)' == ''">false</Mu3DEnableUltraHdrHarness>
  </PropertyGroup>

  <!--
    Keep the diagnostic app's generated bindings and native runtime in one atomic APK.
    Android Fast Deployment can otherwise leave an older managed surface configuration
    beside a newly staged wgpu-native library, and invalid surface configurations are
    process-fatal in wgpu-native v29 rather than catchable managed exceptions.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Mu3DDocumentationBaseUrl" Value="$(Mu3DDocumentationBaseUrl)" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              Color="#111827" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#111827"
                      BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**"
               LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The in-app source drawer is desktop-only. Keep copyable source out of Android and iOS
       packages instead of shipping assets that those layouts never expose. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <MauiAsset Include="Pages\*Page.xaml"
               LogicalName="GallerySource/%(Filename)%(Extension)" />
    <MauiAsset Include="Examples/*.cs;Pages/*Presenter.cs;Pages/ColorComparisonRenderer.cs;Pages/OpenPbrTextureExample.cs;Pages/OpenPbrParameterEditor.cs;Pages/SurfaceReferencePattern.cs;Pages/OpenPbrFurnaceRenderer.cs;Pages/FurnaceSettingsQueue.cs;Pages/CmykPrintingPattern.cs;Pages/HdrJpegRoundTrip.cs;Pages/GltfInstancesExample.cs;Pages/ModelLabCatalog.cs;Pages/ModelLabAssets.cs;Pages/GalleryEnvironment.cs;Pages/GalleryAssets.cs;Pages/PointerPenInputPage.PencilPreview.cs;Pages/PointerPenInputPage.Windows.cs;Pages/PenTip*.cs;Pages/PointerInputBridge*.cs;Pages/MapControlsPage.Keyboard.Desktop.cs;Pages/FlyControlsPage.Keyboard.Desktop.cs;Pages/ProductFeedData.cs;Pages/ProductFeedPage.Output.cs;Pages/ProductFeedPage.Diagnostics.cs"
               LogicalName="GallerySource/%(Filename)%(Extension)" />
    <MauiAsset Include="Pages\*Page.xaml.cs"
               LogicalName="GallerySource/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableMu3DPrinting)' != 'true'">
    <MauiAsset Remove="Pages/CmykPrintingPage.xaml;Pages/CmykPrinting*.cs;Examples/CmykPrintingExample.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <ProjectReference Include="../../src/Mu3D.Maui/Mu3D.Maui.csproj" />
    <ProjectReference Include="../../src/Mu3D.Toolkit/Mu3D.Toolkit.csproj" />
    <ProjectReference Include="../../src/Mu3D.Creative/Mu3D.Creative.csproj" />
    <ProjectReference Include="../../src/Mu3D.Formats.MaterialX/Mu3D.Formats.MaterialX.csproj" />
    <ProjectReference Include="../../src/Mu3D.Rendering.OpenPbr/Mu3D.Rendering.OpenPbr.csproj" />
    <ProjectReference Include="../../src/Mu3D.Maui.Toolkit/Mu3D.Maui.Toolkit.csproj" />
    <ProjectReference Include="../../src/Mu3D.Formats.Gltf/Mu3D.Formats.Gltf.csproj" />
    <ProjectReference Include="../../src/Mu3D.Native.UltraHdr/Mu3D.Native.UltraHdr.csproj" />
    <ProjectReference Include="../../src/Mu3D.Native.Ktx/Mu3D.Native.Ktx.csproj" />
    <PackageReference Include="Mu3D.Native.Wgpu.Runtime"
                      Version="[$(Mu3DPackageVersion)]"
                      Condition="'$(Mu3DUseRuntimePackages)' == 'true'" />
    <PackageReference Include="Mu3D.Native.UltraHdr.Runtime.Jpeg"
                      Version="[$(Mu3DPackageVersion)]"
                      Condition="'$(Mu3DUseRuntimePackages)' == 'true'" />
    <PackageReference Include="Mu3D.Native.Ktx.Runtime"
                      Version="[$(Mu3DPackageVersion)]"
                      Condition="'$(Mu3DUseRuntimePackages)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableKtxHarness)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="$(_Mu3DKtxRuntimeRoot)\android-arm\native\libktx.so" Abi="armeabi-v7a" />
    <AndroidNativeLibrary Include="$(_Mu3DKtxRuntimeRoot)\android-arm64\native\libktx.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(_Mu3DKtxRuntimeRoot)\android-x86\native\libktx.so" Abi="x86" />
    <AndroidNativeLibrary Include="$(_Mu3DKtxRuntimeRoot)\android-x64\native\libktx.so" Abi="x86_64" />
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableKtxHarness)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="$(_Mu3DKtxRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\ktx.dll">
      <Link>ktx.dll</Link>
      <TargetPath>ktx.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableKtxHarness)' == 'true' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst')">
    <NativeReference Include="$(_Mu3DKtxRuntimeRoot)\$(_Mu3DKtxRuntimeIdentifier)\native\libktx.a">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <IsCxx>true</IsCxx>
    </NativeReference>
    <LinkerArgument Include="-lc++" />
    <!-- P/Invoke lookup does not create a native object-file reference. Keep every consumed
         libktx C ABI entry alive explicitly; a wildcard is not expanded by ReferenceNativeSymbol. -->
    <ReferenceNativeSymbol Include="ktxTexture2_CreateFromMemory;ktxTexture2_Destroy;ktxTexture2_NeedsTranscoding;ktxTexture2_GetTransferFunction_e;ktxTexture2_GetPrimaries_e;ktxTexture2_GetPremultipliedAlpha;ktxTexture2_TranscodeBasis;ktxTexture2_GetImageOffset;ktxTexture_GetData;ktxTexture_GetDataSize;ktxHashList_FindValue">
      <SymbolType>Function</SymbolType>
    </ReferenceNativeSymbol>
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableUltraHdrHarness)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-arm\native\libuhdr.so" Abi="armeabi-v7a" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-arm\native\libturbojpeg.so" Abi="armeabi-v7a" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-arm64\native\libuhdr.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-arm64\native\libturbojpeg.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-x86\native\libuhdr.so" Abi="x86" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-x86\native\libturbojpeg.so" Abi="x86" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-x64\native\libuhdr.so" Abi="x86_64" />
    <AndroidNativeLibrary Include="$(_Mu3DUltraHdrRuntimeRoot)\android-x64\native\libturbojpeg.so" Abi="x86_64" />
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableUltraHdrHarness)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\uhdr.dll">
      <Link>uhdr.dll</Link>
      <TargetPath>uhdr.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\turbojpeg.dll">
      <Link>turbojpeg.dll</Link>
      <TargetPath>turbojpeg.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableUltraHdrHarness)' == 'true' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst')">
    <NativeReference Include="$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libuhdr.a">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
    </NativeReference>
    <NativeReference Include="$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libturbojpeg.a">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libuhdr.a" />
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libturbojpeg.a" />
    <LinkerArgument Include="-lc++" />
    <ReferenceNativeSymbol Include="@(_Mu3DUltraHdrNativeSymbol);@(_Mu3DTurboJpegNativeSymbol)">
      <SymbolType>Function</SymbolType>
    </ReferenceNativeSymbol>
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(_Mu3DDeviceHarnessEnabled)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="$(_Mu3DDeviceHarnessRuntimeRoot)\android-arm\native\libwgpu_native.so" Abi="armeabi-v7a" />
    <AndroidNativeLibrary Include="$(_Mu3DDeviceHarnessRuntimeRoot)\android-arm64\native\libwgpu_native.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(_Mu3DDeviceHarnessRuntimeRoot)\android-x86\native\libwgpu_native.so" Abi="x86" />
    <AndroidNativeLibrary Include="$(_Mu3DDeviceHarnessRuntimeRoot)\android-x64\native\libwgpu_native.so" Abi="x86_64" />
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(_Mu3DDeviceHarnessEnabled)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Content Include="$(_Mu3DWindowsRuntimeFile)">
      <Link>wgpu_native.dll</Link>
      <TargetPath>wgpu_native.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(_Mu3DDeviceHarnessEnabled)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <NativeReference Include="$(_Mu3DDeviceHarnessRuntimeRoot)\$(RuntimeIdentifier)\native\libwgpu_native.a">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Metal QuartzCore Foundation</Frameworks>
    </NativeReference>
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(_Mu3DDeviceHarnessRuntimeRoot)\$(RuntimeIdentifier)\native\libwgpu_native.a" />
    <ReferenceNativeSymbol Include="wgpu%2A">
      <SymbolType>Function</SymbolType>
    </ReferenceNativeSymbol>
  </ItemGroup>

  <ItemGroup Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(_Mu3DDeviceHarnessEnabled)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <NativeReference Include="$(_Mu3DDeviceHarnessRuntimeRoot)\$(RuntimeIdentifier)\native\libwgpu_native.a">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Metal QuartzCore Foundation</Frameworks>
    </NativeReference>
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(_Mu3DDeviceHarnessRuntimeRoot)\$(RuntimeIdentifier)\native\libwgpu_native.a" />
    <ReferenceNativeSymbol Include="wgpu%2A">
      <SymbolType>Function</SymbolType>
    </ReferenceNativeSymbol>
  </ItemGroup>

  <Target Name="ValidateMu3DDeviceHarnessRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(_Mu3DDeviceHarnessEnabled)' == 'true'">
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DDeviceHarnessRuntimeRoot)\android-arm64\native\libwgpu_native.so')"
           Text="Prepare the pinned Android Release runtimes before enabling the Mu3D device harness." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DDeviceHarnessRuntimeRoot)\android-arm\native\libwgpu_native.so')"
           Text="The pinned Android arm Release runtime is missing from the Mu3D device harness staging directory." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DDeviceHarnessRuntimeRoot)\android-x86\native\libwgpu_native.so')"
           Text="The pinned Android x86 Release runtime is missing from the Mu3D device harness staging directory." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DDeviceHarnessRuntimeRoot)\android-x64\native\libwgpu_native.so')"
           Text="The pinned Android x64 Release runtime is missing from the Mu3D device harness staging directory." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !Exists('$(_Mu3DDeviceHarnessRuntimeRoot)\$(RuntimeIdentifier)\native\libwgpu_native.a')"
           Text="Prepare the pinned iOS Release runtime for $(RuntimeIdentifier) before enabling the Mu3D device harness." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(RuntimeIdentifier)' == ''"
           Text="GalleryApp requires an explicit Mac Catalyst RuntimeIdentifier (maccatalyst-arm64 or maccatalyst-x64)." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(RuntimeIdentifier)' != '' And !Exists('$(_Mu3DDeviceHarnessRuntimeRoot)\$(RuntimeIdentifier)\native\libwgpu_native.a')"
           Text="The pinned Mac Catalyst Release runtime for $(RuntimeIdentifier) is missing. Run the documented prepare-platform-runtimes maccatalyst release command." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And !Exists('$(_Mu3DWindowsRuntimeFile)')"
           Text="Prepare the pinned Windows Release runtime for $(_Mu3DWindowsRuntimeRid) before running GalleryApp." />
  </Target>

  <Target Name="ValidateMu3DUltraHdrHarnessRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableUltraHdrHarness)' == 'true'">
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And (!Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-arm\native\libuhdr.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-arm\native\libturbojpeg.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-arm64\native\libuhdr.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-arm64\native\libturbojpeg.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-x86\native\libuhdr.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-x86\native\libturbojpeg.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-x64\native\libuhdr.so') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\android-x64\native\libturbojpeg.so'))"
           Text="The complete verified Android libultrahdr/libjpeg-turbo runtime set is missing." />
    <Error Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') And '$(_Mu3DUltraHdrRuntimeIdentifier)' == ''"
           Text="The Gallery Ultra HDR harness requires an explicit Apple RuntimeIdentifier." />
    <Error Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst') And '$(_Mu3DUltraHdrRuntimeIdentifier)' != '' And (!Exists('$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libuhdr.a') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DUltraHdrRuntimeIdentifier)\native\libturbojpeg.a'))"
           Text="The verified Apple codec runtime for $(_Mu3DUltraHdrRuntimeIdentifier) is incomplete." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And (!Exists('$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\uhdr.dll') Or !Exists('$(_Mu3DUltraHdrRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\turbojpeg.dll'))"
           Text="The verified Windows codec runtime for $(_Mu3DWindowsRuntimeRid) is incomplete." />
  </Target>

  <Target Name="ValidateMu3DKtxHarnessRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(Mu3DUseRuntimePackages)' != 'true' And '$(Mu3DEnableKtxHarness)' == 'true'">
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DKtxRuntimeRoot)\android-arm64\native\libktx.so')"
           Text="Download the verified KTX workflow artifact before enabling the Android Gallery KTX harness." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DKtxRuntimeRoot)\android-arm\native\libktx.so')"
           Text="The verified KTX Android arm runtime is missing." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DKtxRuntimeRoot)\android-x86\native\libktx.so')"
           Text="The verified KTX Android x86 runtime is missing." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And !Exists('$(_Mu3DKtxRuntimeRoot)\android-x64\native\libktx.so')"
           Text="The verified KTX Android x64 runtime is missing." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(_Mu3DKtxRuntimeIdentifier)' == ''"
           Text="The Gallery KTX harness requires an explicit iOS RuntimeIdentifier." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(_Mu3DKtxRuntimeIdentifier)' != '' And !Exists('$(_Mu3DKtxRuntimeRoot)\$(_Mu3DKtxRuntimeIdentifier)\native\libktx.a')"
           Text="The verified KTX iOS runtime for $(_Mu3DKtxRuntimeIdentifier) is missing." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(_Mu3DKtxRuntimeIdentifier)' == ''"
           Text="The Gallery KTX harness requires an explicit Mac Catalyst RuntimeIdentifier." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(_Mu3DKtxRuntimeIdentifier)' != '' And !Exists('$(_Mu3DKtxRuntimeRoot)\$(_Mu3DKtxRuntimeIdentifier)\native\libktx.a')"
           Text="The verified KTX Mac Catalyst runtime for $(_Mu3DKtxRuntimeIdentifier) is missing." />
    <Error Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And !Exists('$(_Mu3DKtxRuntimeRoot)\$(_Mu3DWindowsRuntimeRid)\native\ktx.dll')"
           Text="The verified KTX Windows runtime for $(_Mu3DWindowsRuntimeRid) is missing." />
  </Target>
  <Import Project="../../src/Mu3D.Rendering.OpenPbr/buildTransitive/Mu3D.Rendering.OpenPbr.targets" />
</Project>
