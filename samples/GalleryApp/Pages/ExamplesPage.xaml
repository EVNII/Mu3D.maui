<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mu3D.GalleryApp.Pages.ExamplesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gallery="clr-namespace:Mu3D.GalleryApp"
    xmlns:pages="clr-namespace:Mu3D.GalleryApp.Pages"
    x:DataType="pages:ExamplesPage"
    Title="Examples">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="24,24,24,14" Spacing="6">
            <Label FontAttributes="Bold" FontSize="32" Text="Examples" />
            <Label Text="Explore Mu3D rendering, formats, animation, HDR and native-runtime diagnostics." />
        </VerticalStackLayout>
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Examples}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gallery:GalleryExample">
                    <Grid
                        Margin="24,6"
                        Padding="18"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="14">
                        <Label
                            FontAttributes="Bold"
                            Text="{Binding Monogram}"
                            VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding Title}" />
                            <Label
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Description}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            FontSize="22"
                            Text="›"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
