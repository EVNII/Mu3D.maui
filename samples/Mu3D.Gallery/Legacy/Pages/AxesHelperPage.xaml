<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mu3D.GalleryApp.Pages.AxesHelperPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gallery="clr-namespace:Mu3D.GalleryApp"
    xmlns:mu3d="clr-namespace:Mu3D.Maui.Controls;assembly=Mu3D.Maui"
    xmlns:toolkit="clr-namespace:Mu3D.Maui.Toolkit.Controls;assembly=Mu3D.Maui.Toolkit"
    Title="Axes Helper">
    <ContentPage.ToolbarItems>
        <gallery:GalleryDocumentationToolbarItem FeatureId="axes-helper" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="*,Auto">
        <mu3d:Mu3DSceneView
            x:Name="SceneView"
            BackgroundColor="Black"
            FeatureError="OnFeatureError"
            SurfaceError="OnSurfaceError">
            <mu3d:Mu3DSceneView.SceneContent>
                <mu3d:Scene3D Name="Axes helper scene">
                    <mu3d:Scene3D.Camera>
                        <mu3d:PerspectiveCamera3D
                            x:Name="SceneCamera"
                            FieldOfView="50"
                            Name="Axes camera"
                            X="3.4"
                            Y="2.5"
                            Z="6.2" />
                    </mu3d:Scene3D.Camera>
                    <mu3d:Cone3D
                        Height="2.2"
                        Name="Positive X cone"
                        Radius="0.75"
                        X="-1.25">
                        <mu3d:PbrMaterial3D
                            Color="#35A7FF"
                            Metallic="0.22"
                            Roughness="0.25" />
                    </mu3d:Cone3D>
                    <mu3d:Sphere3D
                        Name="Negative X sphere"
                        Radius="0.82"
                        X="1.2"
                        Y="-0.12">
                        <mu3d:PbrMaterial3D
                            Color="#FF8B38"
                            Metallic="0.12"
                            Roughness="0.3" />
                    </mu3d:Sphere3D>
                    <mu3d:Sphere3D
                        Name="Ground marker"
                        Radius="0.34"
                        ScaleX="5"
                        ScaleY="0.13"
                        ScaleZ="5"
                        Y="-1.22">
                        <mu3d:UnlitMaterial3D Color="#17243A" />
                    </mu3d:Sphere3D>
                    <mu3d:DirectionalLight3D
                        Intensity="4.2"
                        RotationX="-35"
                        RotationY="-30" />
                </mu3d:Scene3D>
            </mu3d:Mu3DSceneView.SceneContent>
            <mu3d:Mu3DSceneView.Features>
                <toolkit:ViewportTools>
                    <toolkit:OrbitTool
                        x:Name="SceneOrbit"
                        Camera="{x:Reference SceneCamera}"
                        DampingEnabled="True"
                        DampingTime="0.1"
                        MaximumDistance="18"
                        MinimumDistance="2.5" />
                    <toolkit:AxesHelper
                        x:Name="NavigationAxes"
                        InteractionFailed="OnAxesFailed"
                        IsInteractive="True"
                        Margin="16"
                        Orbit="{x:Reference SceneOrbit}"
                        Placement="TopRight"
                        ScreenSize="126"
                        ShowDiagonalViews="True"
                        ShowNegativeAxes="True"
                        ViewRequested="OnViewRequested" />
                </toolkit:ViewportTools>
            </mu3d:Mu3DSceneView.Features>
        </mu3d:Mu3DSceneView>
        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="7">
            <Label
                FontAttributes="Bold"
                Text="Click a colored axis endpoint for an orthogonal view; click a white dot for a 45° view." />
            <HorizontalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Interactive" VerticalTextAlignment="Center" />
                    <Switch
                        IsToggled="{Binding IsInteractive, Mode=TwoWay, Source={x:Reference NavigationAxes}, x:DataType=toolkit:AxesHelper}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="45° handles" VerticalTextAlignment="Center" />
                    <Switch
                        IsToggled="{Binding ShowDiagonalViews, Mode=TwoWay, Source={x:Reference NavigationAxes}, x:DataType=toolkit:AxesHelper}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Negative axes" VerticalTextAlignment="Center" />
                    <Switch
                        IsToggled="{Binding ShowNegativeAxes, Mode=TwoWay, Source={x:Reference NavigationAxes}, x:DataType=toolkit:AxesHelper}" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
            <Label
                x:Name="StatusLabel"
                FontSize="12"
                Text="Axes overlay and Orbit share the ViewportTools lifecycle and control arbiter." />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
