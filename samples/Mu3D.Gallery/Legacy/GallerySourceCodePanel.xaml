<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Mu3D.GalleryApp.GallerySourceCodePanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    AutomationId="GallerySourceCodePanel"
    IsVisible="False">
    <Grid Padding="12" RowDefinitions="Auto,Auto" RowSpacing="8">
        <Button
            x:Name="ExpandButton"
            AutomationId="GallerySourceCodeExpand"
            Clicked="OnExpandClicked"
            HorizontalOptions="Start"
            Text="Show example code" />

        <Grid
            x:Name="ExpandedContent"
            Grid.Row="1"
            IsVisible="False"
            RowDefinitions="Auto,320"
            RowSpacing="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button
                    x:Name="XamlButton"
                    AutomationId="GallerySourceCodeXaml"
                    Clicked="OnXamlClicked"
                    Text="XAML" />
                <Button
                    x:Name="CSharpButton"
                    Grid.Column="1"
                    AutomationId="GallerySourceCodeCSharp"
                    Clicked="OnCSharpClicked"
                    Text="C#" />
                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    Grid.Column="2"
                    HorizontalOptions="End"
                    IsRunning="False"
                    IsVisible="False"
                    VerticalOptions="Center" />
                <Button
                    x:Name="CopyButton"
                    Grid.Column="3"
                    AutomationId="GallerySourceCodeCopy"
                    Clicked="OnCopyClicked"
                    Text="Copy" />
            </Grid>

            <Editor
                x:Name="SourceEditor"
                Grid.Row="1"
                AutomationId="GallerySourceCodeText"
                AutoSize="Disabled"
                FontFamily="monospace"
                IsReadOnly="True"
                Placeholder="Loading example source…" />
        </Grid>
    </Grid>
</ContentView>
