<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Mu3D.Gallery"
             x:Class="Mu3D.Gallery.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- AdaptiveShell resolves its selected navigation item color from the application
                 resource named "Primary" when AShell.SelectedItemColor is not set. -->
            <Color x:Key="Primary">#4A9DFF</Color>
            <Color x:Key="PageBackground">#111827</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
