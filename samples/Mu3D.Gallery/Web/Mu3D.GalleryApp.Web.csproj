<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mu3D.GalleryApp.Web</RootNamespace>
    <AssemblyName>Mu3D.GalleryApp.Web</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Mu3DIncludeBrowserBackend>true</Mu3DIncludeBrowserBackend>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <CompressionEnabled>false</CompressionEnabled>
    <TrimMode>full</TrimMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <IntermediateOutputPath>obj/$(Configuration)/Interpreted/</IntermediateOutputPath>
    <IntermediateOutputPath Condition="'$(RunAOTCompilation)' == 'true'">obj/$(Configuration)/Aot/</IntermediateOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableMu3DPrinting Condition="'$(EnableMu3DPrinting)' == ''">true</EnableMu3DPrinting>
    <DefineConstants Condition="'$(EnableMu3DPrinting)' == 'true'">$(DefineConstants);MU3D_PRINTING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GalleryCatalog.cs" Link="Gallery/GalleryCatalog.cs" />
    <Content Include="../Resources/Images/*.svg" Link="wwwroot/navigation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Pages/*Page.xaml;../Pages/*Page.xaml.cs;../Pages/*Presenter.cs;../Pages/SampleEnvironment.cs;../Controls/SceneHostView.cs;../Controls/IGalleryPageActivation.cs"
             Link="wwwroot/GallerySource/Adaptive/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <ProjectReference Include="../../../src/Mu3D.Web.Toolkit/Mu3D.Web.Toolkit.csproj" />
    <ProjectReference Include="../../../src/Mu3D.Rendering.OpenPbr/Mu3D.Rendering.OpenPbr.csproj" />
    <ProjectReference Include="../../../src/Mu3D.Formats.MaterialX/Mu3D.Formats.MaterialX.csproj" />
    <ProjectReference Include="../../../src/Mu3D.Creative/Mu3D.Creative.csproj" />
    <ProjectReference Include="../../../src/Mu3D.Color.Printing/Mu3D.Color.Printing.csproj" Condition="'$(EnableMu3DPrinting)' == 'true'" />
    <ProjectReference Include="../../../src/Mu3D.Formats.Gltf/Mu3D.Formats.Gltf.csproj" />
    <Compile Include="../Legacy/Examples/*.cs" Exclude="../Legacy/Examples/CmykPrintingExample.cs" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/Examples/CmykPrintingExample.cs;../Legacy/Pages/CmykPrintingPattern.cs" Condition="'$(EnableMu3DPrinting)' == 'true'" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/Pages/HdrJpegRoundTrip.cs;../Legacy/Pages/ModelLabCatalog.cs" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/Pages/ModelLabAssets.cs;../Legacy/Pages/GltfInstancesExample.cs;../Legacy/Pages/PenTipPreview.cs;../Legacy/Pages/PenTipScreenSpaceShadowPass.cs" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/Pages/OpenPbrTextureExample.cs;../Legacy/Pages/OpenPbrFurnaceRenderer.cs" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/GalleryNavigationCatalog.cs;../Legacy/GalleryFeatureCatalog.cs;../Legacy/GalleryRoutes.cs;../Legacy/GallerySourceCatalog.cs" Link="Gallery/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/Pages/LightingLabPresenter.cs;../Legacy/Pages/OcclusionLabPresenter.cs;../Legacy/Pages/MaterialTexturePresenter.cs" Link="Examples/%(Filename)%(Extension)" />
    <Compile Include="../Legacy/Pages/ColorComparisonRenderer.cs" Link="Examples/ColorComparisonRenderer.cs" />
    <Compile Include="../Legacy/Pages/GltfScenePresenter.cs;../Legacy/Pages/KtxTextureLabPresenter.cs;../Legacy/Pages/ModelLabPresenter.cs;../Legacy/Pages/AnimationLabPresenter.cs;../Legacy/Pages/GalleryEnvironment.cs" Link="Examples/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Legacy/Pages/*Page.xaml" LogicalName="Mu3D.GalleryApp.NativePages.%(Filename).xaml" />
    <EmbeddedResource Include="../Pages/EmissiveMaterialPage.xaml;../Pages/TranslucentCanvasPage.xaml;../Pages/PaintingColorSpacesPage.xaml;../Pages/LicensePage.xaml"
                      LogicalName="Mu3D.GalleryApp.NativePages.%(Filename).xaml" />
    <Content Include="../Resources/Raw/**" Link="wwwroot/assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Legacy/Pages/*.xaml;../Legacy/Pages/*.cs;../Legacy/Examples/*.cs" Exclude="../Legacy/Pages/CmykPrinting*;../Legacy/Examples/CmykPrintingExample.cs" Link="wwwroot/GallerySource/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Legacy/Pages/CmykPrinting*;../Legacy/Examples/CmykPrintingExample.cs" Condition="'$(EnableMu3DPrinting)' == 'true'" Link="wwwroot/GallerySource/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(Mu3DPrintProfileDirectory)/*.icc" Condition="'$(EnableMu3DPrinting)' == 'true' And '$(Mu3DPrintProfileDirectory)' != ''" Link="wwwroot/assets/PrintProfiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableMu3DPrinting)' != 'true'">
    <Content Remove="Pages/CmykPrinting.razor" />
    <RazorComponent Remove="Pages/CmykPrinting.razor" />
  </ItemGroup>
  <Import Project="Infrastructure/BrowserBackend.targets" />
  <Import Project="Infrastructure/BrowserCodecs.targets" />
</Project>
