@inject NavigationManager Navigation
<GalleryShell>
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="route"><RouteView @key="Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]" RouteData="@route" /></Found>
    <NotFound><main><h1>页面不存在</h1><a href="examples">All Examples</a></main></NotFound>
</Router>
</GalleryShell>

