@page "/examples/gltf-product-feed"
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Mu3D.GalleryApp.Pages
@using Mu3D.GalleryApp.Web.Infrastructure
@using Mu3D.Color
@using Mu3D.Graphics
@using Mu3D.Rendering
@using Mu3D.SceneGraph
@using static Mu3D.GalleryApp.Pages.ProductFeedPolicy

<main><h1>3D Product Feed</h1>
    <p>原 Gallery 的六种模型、60 个商品、共享设备与有界预加载。透明商品通过 premultiplied HDR Canvas 与页面底层合成。</p>
    <p role="status">@status</p>
    <p>预加载 3 cm；暂停 6 cm / 1.5 s；释放 12 cm / 5 s。浏览器距离按 CSS cm 换算。</p>
    <canvas id="product-device" style="display:none" aria-hidden="true"></canvas>
    <div class="product-feed" @ref="feed">
        @for (int index = 0; index < items.Length; index++)
        {
            int current = index; var item = items[current];
            <article class="product-card" @key="current">
                <div class="product-output">
                    <div class="product-underlay">WEB HDR UNDERLAY<br />VISIBLE OUTSIDE MODEL</div>
                    <canvas id="@($"product-{current}")" data-product="@current" data-transparent="@item.Transparent.ToString().ToLowerInvariant()" aria-label="@item.Name"></canvas>
                    @if (!item.Presented) { <div class="product-poster">@item.State</div> }
                </div>
                <strong>@item.Name</strong><p>$@(49 + current * 37 % 450) · @item.State</p>
            </article>
        }
    </div>
</main>

@code {
    private sealed class Item(int index)
    {
        internal ProductModel Model { get; } = ProductModels.All[index % ProductModels.All.Length];
        internal bool Transparent => Model.AlternatesHdrTransparencyProbe ? (index / ProductModels.All.Length) % 2 == 0 : index % 2 == 0;
        internal string Name => $"{Model.DisplayName} #{index + 1}" + (Model.AlternatesHdrTransparencyProbe ? Transparent ? " · HDR alpha" : " · opaque direct HDR" : "");
        internal ProductSceneContent? Content;
        internal RenderSession? Session;
        internal CancellationTokenSource? Loading;
        internal DateTimeOffset? OutsideSince;
        internal double Distance = double.MaxValue, AnimationTime;
        internal bool Promoted, Presented;
        internal string State = "Poster";
    }
    private readonly Item[] items = Enumerable.Range(0, MaximumDemoProductCount).Select(index => new Item(index)).ToArray();
    private readonly CancellationTokenSource lifetime = new();
    private readonly SemaphoreSlim loadSlots = new(MaximumConcurrentLoads);
    private readonly List<Task> loads = [];
    private ProductAssetProvider? assets;
    private RenderSession? deviceOwner;
    private SceneRenderer? renderer;
    private IJSObjectReference? module, host;
    private DotNetObjectReference<ProductFeed>? reference;
    private ElementReference feed;
    private Task? startup, disposal;
    private bool disposed, schedulingLoads;
    private int definitions, frames;
    private string status = "正在连接共享 GPU…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) { startup = StartAsync(); await startup; } }
    private async Task StartAsync()
    {
        try
        {
            assets = new(() => definitions++, () => { });
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./product-feed.mjs");
            if (disposed) return;
            deviceOwner = await RenderSession.OpenAsync("#product-device");
            if (disposed) return;
            renderer = new(deviceOwner.Device, GraphicsTextureFormat.Rgba16Float);
            reference = DotNetObjectReference.Create(this);
            host = await module.InvokeAsync<IJSObjectReference>("create", feed, reference, deviceOwner.MaximumDimension);
        }
        catch (Exception error) { if (!disposed) { status = error.Message; await InvokeAsync(StateHasChanged); } }
    }
    [JSInvokable]
    public async Task UpdateLayout(double[] distances, bool scrolling)
    {
        if (disposed || host is null || assets is null || distances.Length != items.Length) return;
        DateTimeOffset now = DateTimeOffset.UtcNow;
        // Publish the complete layout snapshot before any awaited promotion or load completion.
        for (int index = 0; index < items.Length; index++)
        {
            Item item = items[index]; item.Distance = Math.Abs(distances[index]);
            if (item.Distance == 0) item.OutsideSince = null; else item.OutsideSince ??= now;
        }
        for (int index = 0; index < items.Length; index++)
        {
            if (disposed) return;
            Item item = items[index];
            bool near = item.Distance <= PreloadDistanceCentimeters * 96 / 2.54;
            TimeSpan outside = now - (item.OutsideSince ?? now);
            if (near)
            {
                if (item.Content is not null && !item.Promoted) await Promote(index);
            }
            else if (!scrolling)
            {
                bool release = item.Distance >= ReleaseDistanceCentimeters * 96 / 2.54 || outside >= ReleaseDelay;
                if (release)
                {
                    item.Loading?.Cancel();
                    if (item.Session is not null) { await host.InvokeVoidAsync("setReady", index, false, false); item.Session.Dispose(); item.Session = null; }
                    item.Content = null; item.Promoted = item.Presented = false; item.State = "Poster";
                }
                else if (item.Promoted && (item.Distance >= SuspendDistanceCentimeters * 96 / 2.54 || outside >= SuspendDelay))
                { await host.InvokeVoidAsync("setReady", index, false, false); item.Promoted = item.Presented = false; item.State = "Warm"; }
            }
        }
        if (disposed) return;
        ScheduleLoads();
        renderer?.TrimCaches(items.Select(item => item.Content?.Scene).OfType<Scene>());
        PublishStatus(); await InvokeAsync(StateHasChanged);
    }
    private void ScheduleLoads()
    {
        if (disposed || host is null || assets is null || schedulingLoads) return;
        int available = MaximumConcurrentLoads - items.Count(item => item.Loading is not null);
        if (available <= 0) return;
        schedulingLoads = true;
        try
        {
            // Reserve only free native-policy slots; do not enqueue every preload candidate behind a semaphore.
            int[] candidates = Enumerable.Range(0, items.Length)
                .Where(index => items[index].Distance <= PreloadDistanceCentimeters * 96 / 2.54 &&
                    items[index].Content is null && items[index].Loading is null)
                .OrderBy(index => items[index].Distance == 0 ? 0 : 1)
                .ThenBy(index => items[index].Distance).ThenBy(index => index).Take(available).ToArray();
            foreach (int index in candidates) if (!disposed) BeginLoad(index);
        }
        finally { schedulingLoads = false; }
    }
    private void BeginLoad(int index)
    {
        Item item = items[index]; item.Loading = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        item.State = item.Distance == 0 ? "Loading…" : "Prefetch";
        loads.RemoveAll(task => task.IsCompleted); loads.Add(LoadAsync(index, item.Loading));
    }
    private async Task LoadAsync(int index, CancellationTokenSource cancellation)
    {
        bool entered = false;
        try
        {
            await loadSlots.WaitAsync(cancellation.Token); entered = true;
            ProductSceneContent content = await assets!.GetContentAsync(index, items[index].Name, items[index].Model, cancellation.Token);
            if (disposed || cancellation.IsCancellationRequested || items[index].Loading != cancellation) return;
            items[index].Content = content; items[index].State = "Warm";
            if (items[index].Distance <= PreloadDistanceCentimeters * 96 / 2.54) await Promote(index);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception error) { if (!disposed) { items[index].Presented = false; items[index].State = $"Failed: {error.Message}"; } }
        finally
        {
            if (entered) loadSlots.Release();
            if (items[index].Loading == cancellation) items[index].Loading = null;
            cancellation.Dispose();
            if (!disposed) { ScheduleLoads(); PublishStatus(); await InvokeAsync(StateHasChanged); }
        }
    }
    private async Task Promote(int index)
    {
        Item item = items[index];
        if (disposed || deviceOwner is null || host is null || item.Content is null) return;
        item.Session ??= deviceOwner.CreateSharedCanvas($"#product-{index}", item.Transparent);
        item.Promoted = true; item.State = "Ready";
        await host.InvokeVoidAsync("setReady", index, true, item.Model.AnimatesRotation);
    }
    [JSInvokable]
    public async Task DrawProduct(int index, int width, int height, double delta, bool refresh)
    {
        if (disposed || (uint)index >= items.Length) return;
        Item item = items[index];
        if (!item.Promoted || item.Session is null || item.Content is null || renderer is null) return;
        ProductSceneContent content = item.Content; item.AnimationTime += delta;
        content.AdvanceAnimation(TimeSpan.FromSeconds(item.AnimationTime));
        if (content.Camera is PerspectiveCamera camera) camera.AspectRatio = (float)width / height;
        await item.Session.DrawExampleAsync(width, height, 0, true, refresh, (_, target, depth) =>
            renderer.Render(content.Scene, content.Camera, target, depth!, item.Transparent
                ? new LinearRgba(0, 0, 0, 0, StandardColorSpaces.LinearSrgb)
                : NativeGalleryScene.Color("#7D8998")));
        if (disposed) return;
        bool firstPresentation = !item.Presented;
        item.Presented = true; item.State = "Live";
        bool publish = frames++ % 16 == 0;
        if (firstPresentation || publish) { PublishStatus(); await InvokeAsync(StateHasChanged); }
    }
    [JSInvokable] public Task ProductFailed(int index, string message)
    { if (disposed) return Task.CompletedTask; items[index].Presented = false; items[index].State = "Failed: " + message; return InvokeAsync(StateHasChanged); }
    private void PublishStatus() => status = $"60 products · visible {items.Count(item => item.Distance == 0)} · live {items.Count(item => item.Promoted)} · warm {items.Count(item => item.Content is not null)} · definition cache {assets?.DefinitionCacheCount}/6 · content cache {assets?.WarmContentCount}/16 · loads {definitions} · meshes {renderer?.CachedMeshCount} · geometry {renderer?.CachedGeometryCount} · one GPU device";
    public ValueTask DisposeAsync() => new(disposal ??= DisposeCoreAsync());
    private async Task DisposeCoreAsync()
    {
        disposed = true; lifetime.Cancel();
        if (startup is not null) await startup;
        try { if (host is not null) { await host.InvokeVoidAsync("dispose"); await host.DisposeAsync(); } }
        finally
        {
            await Task.WhenAll(loads); assets?.Dispose(); renderer?.Dispose(); renderer = null;
            foreach (Item item in items) { item.Session?.Dispose(); item.Session = null; item.Content = null; }
            deviceOwner?.Dispose(); reference?.Dispose(); lifetime.Dispose(); loadSlots.Dispose();
            if (module is not null) await module.DisposeAsync();
        }
    }
}
