@page "/examples/procedural-feed"
@implements IAsyncDisposable
@inject IJSRuntime JS
@using System.Diagnostics.CodeAnalysis
@using Mu3D.Gallery.Pages
@using Mu3D.GalleryApp.Web.Infrastructure
@using Mu3D.Graphics
@using Mu3D.Rendering
@using Mu3D.SceneGraph
@using static Mu3D.Gallery.Pages.ProceduralFeedExample

<main>
<h1>Procedural 3D Feed</h1>
<p>24 native Gallery sphere/cone previews share one GPU device. Visible rows and one neighboring row are live;
    three neighboring rows keep preloaded scenes; distant rows release their content and Canvas surfaces.</p>
<p role="status">@status</p>
<canvas id="procedural-device" style="display:none" aria-hidden="true"></canvas>
<div class="product-feed" @ref="feed">
    @for (int index = 0; index < products.Length; index++)
    {
        int current = index;
        FeedProduct product = products[current];
        <article class="product-card" @key="current">
            <div class="product-output" style="height:170px">
                <canvas id="@($"procedural-{current}")" data-product="@current" data-transparent="false" aria-label="@product.Name" style="height:170px"></canvas>
                @if (!presented[current])
                { <div class="product-poster">@(errors[current] ?? (product.Scene is null ? "Preparing preview…" : product.IsLive ? "Connecting preview…" : "Preloaded"))</div> }
            </div>
            <strong>@product.Name</strong><p>@product.Price</p>
        </article>
    }
</div>

</main>

@code {
    private readonly FeedProduct[] products = Enumerable.Range(0, ProductCount).Select(index => new FeedProduct(index)).ToArray();
    private readonly RenderSession?[] sessions = new RenderSession?[ProductCount];
    private readonly bool[] presented = new bool[ProductCount];
    private readonly string?[] errors = new string?[ProductCount];
    private RenderSession? deviceOwner;
    private SceneRenderer? renderer;
    private IJSObjectReference? module, host;
    private DotNetObjectReference<ProceduralFeed>? reference;
    private ElementReference feed;
    private Task? startup, disposal;
    private bool disposed;
    private int live, warm;
    private string status = "Connecting the shared GPU…";

    [DynamicDependency(DynamicallyAccessedMemberTypes.PublicMethods, typeof(ProceduralFeed))]
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) { startup = StartAsync(); await startup; } }

    private async Task StartAsync()
    {
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./product-feed.mjs");
            if (disposed) return;
            deviceOwner = await RenderSession.OpenAsync("#procedural-device");
            if (disposed) return;
            renderer = new(deviceOwner.Device, GraphicsTextureFormat.Rgba16Float);
            reference = DotNetObjectReference.Create(this);
            host = await module.InvokeAsync<IJSObjectReference>("create", feed, reference, deviceOwner.MaximumDimension);
        }
        catch (Exception error)
        { if (!disposed) { status = error.Message; await InvokeAsync(StateHasChanged); } }
    }

    [JSInvokable]
    public async Task UpdateLayout(double[] distances, bool scrolling)
    {
        if (disposed || host is null || deviceOwner is null || distances.Length != products.Length) return;
        int first = Array.FindIndex(distances, distance => distance == 0);
        int last = Array.FindLastIndex(distances, distance => distance == 0);
        (live, warm) = ProceduralFeedExample.ApplyLifecycle(products, first, last);
        for (int index = 0; index < products.Length; index++)
        {
            if (disposed) return;
            if (!products[index].IsLive)
            {
                if (sessions[index] is RenderSession retiring)
                {
                    // Stop and settle this card's RAF before retiring its separately owned surface.
                    await host.InvokeVoidAsync("setReady", index, false, false);
                    retiring.Dispose(); sessions[index] = null;
                    presented[index] = false;
                }
            }
            else if (sessions[index] is null && errors[index] is null)
            {
                sessions[index] = deviceOwner.CreateSharedCanvas($"#procedural-{index}");
                await host.InvokeVoidAsync("setReady", index, true, false);
            }
        }
        if (disposed) return;
        renderer?.TrimCaches(products.Select(product => product.Scene).OfType<Scene>());
        PublishStatus(); await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task DrawProduct(int index, int width, int height, double delta, bool refresh)
    {
        if (disposed || (uint)index >= products.Length || renderer is null ||
            sessions[index] is not RenderSession session || !products[index].IsLive ||
            products[index].Scene is not Scene scene || products[index].Camera is not Camera camera) return;
        if (camera is PerspectiveCamera perspective) perspective.AspectRatio = (float)width / height;
        await session.DrawExampleAsync(width, height, 0, true, refresh, (_, target, depth) =>
            renderer.Render(scene, camera, target, depth!, NativeGalleryScene.Color("#7D8998")));
        if (disposed) return;
        bool first = !presented[index]; presented[index] = true;
        if (first) { PublishStatus(); await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable]
    public Task ProductFailed(int index, string message)
    {
        if (disposed || (uint)index >= products.Length) return Task.CompletedTask;
        errors[index] = "Preview failed: " + message;
        presented[index] = false;
        return InvokeAsync(StateHasChanged);
    }

    private void PublishStatus() => status = $"{products.Length} products · {live} live · {warm} preloaded · " +
        $"{sessions.Count(session => session is not null)} Canvas surfaces · {presented.Count(value => value)} presented · one GPU device";

    public ValueTask DisposeAsync() => new(disposal ??= DisposeCoreAsync());
    private async Task DisposeCoreAsync()
    {
        disposed = true;
        if (startup is not null) await startup;
        try { if (host is not null) { await host.InvokeVoidAsync("dispose"); await host.DisposeAsync(); } }
        finally
        {
            renderer?.Dispose(); renderer = null;
            foreach (RenderSession? session in sessions) session?.Dispose();
            Array.Clear(sessions);
            foreach (FeedProduct product in products) product.ReleaseContent();
            deviceOwner?.Dispose(); deviceOwner = null;
            reference?.Dispose();
            if (module is not null) await module.DisposeAsync();
        }
    }
}
