<svg viewBox="0 0 64 32" preserveAspectRatio="none" role="img" aria-label="@Title" style="width:100%;height:260px;display:block">
    @for (int index = 0; index < Colors.Length; index++)
    {
        int x = index % 64, y = index / 64;
        <rect x="@x" y="@y" width="1.005" height="1.005" fill="@Colors[index]" />
        @if (Excess?[index] == true)
        {
            <line x1="@(x + .12)" y1="@(y + .88)" x2="@(x + .88)" y2="@(y + .12)" stroke="black" stroke-width="3" vector-effect="non-scaling-stroke" />
            <line x1="@(x + .12)" y1="@(y + .88)" x2="@(x + .88)" y2="@(y + .12)" stroke="white" stroke-width="1" vector-effect="non-scaling-stroke" />
        }
    }
</svg>

@code {
    /// <summary>Gets the accessible title of this explicitly mapped SDR chart.</summary>
    [Parameter] public string Title { get; set; } = "Print color chart";
    /// <summary>Gets the 64 × 32 encoded-sRGB colors produced by the shared print example.</summary>
    [Parameter] public string[] Colors { get; set; } = [];
    /// <summary>Gets the optional diagnostic mask without changing the separation data.</summary>
    [Parameter] public bool[]? Excess { get; set; }
}
