<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mu3D.GalleryApp.Pages.ProgressBridgePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gallery="clr-namespace:Mu3D.GalleryApp"
    xmlns:mu3d="clr-namespace:Mu3D.Maui.Controls;assembly=Mu3D.Maui"
    xmlns:toolkit="clr-namespace:Mu3D.Maui.Toolkit.Controls;assembly=Mu3D.Maui.Toolkit"
    Title="Progress Bridge">
    <ContentPage.ToolbarItems>
        <gallery:GalleryDocumentationToolbarItem FeatureId="progress-bridge" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="*,Auto">
        <mu3d:Mu3DSceneView
            x:Name="SceneView"
            BackgroundColor="Black"
            FeatureError="OnFeatureError"
            SurfaceError="OnSurfaceError">
            <mu3d:Mu3DSceneView.SceneContent>
                <mu3d:Scene3D Name="Progress bridge scene">
                    <mu3d:Scene3D.Camera>
                        <mu3d:PerspectiveCamera3D
                            x:Name="SceneCamera"
                            FieldOfView="50"
                            Name="Progress camera"
                            Z="5.4" />
                    </mu3d:Scene3D.Camera>
                    <mu3d:Cone3D
                        x:Name="AnimatedCone"
                        Height="2.2"
                        Name="Progress target"
                        Radius="0.9"
                        Y="-0.5">
                        <mu3d:PbrMaterial3D
                            Color="#37A6FF"
                            Metallic="0.35"
                            Roughness="0.2" />
                    </mu3d:Cone3D>
                    <mu3d:Sphere3D
                        Radius="0.32"
                        ScaleX="4.8"
                        ScaleY="0.14"
                        ScaleZ="4.8"
                        Y="-1.25">
                        <mu3d:UnlitMaterial3D Color="#18243A" />
                    </mu3d:Sphere3D>
                    <mu3d:DirectionalLight3D
                        Intensity="4.5"
                        RotationX="-35"
                        RotationY="-30" />
                </mu3d:Scene3D>
            </mu3d:Mu3DSceneView.SceneContent>
            <mu3d:Mu3DSceneView.Features>
                <toolkit:ViewportTools>
                    <toolkit:ProgressTool x:Name="SceneProgress">
                        <toolkit:NodeTransformProgress
                            From="-0.5"
                            Property="Y"
                            Target="{x:Reference AnimatedCone}"
                            To="0.65" />
                        <toolkit:NodeTransformProgress
                            From="-35"
                            Property="RotationY"
                            Target="{x:Reference AnimatedCone}"
                            To="325" />
                        <toolkit:NodeTransformProgress
                            From="-1.2"
                            Property="X"
                            Target="{x:Reference SceneCamera}"
                            To="1.2" />
                        <toolkit:NodeTransformProgress
                            From="-12"
                            Property="RotationY"
                            Target="{x:Reference SceneCamera}"
                            To="12" />
                    </toolkit:ProgressTool>
                </toolkit:ViewportTools>
            </mu3d:Mu3DSceneView.Features>
        </mu3d:Mu3DSceneView>
        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="8">
            <Label
                FontAttributes="Bold"
                Text="One ProgressTool drives the node and camera; it owns no animation or scroll source." />
            <Slider
                x:Name="ProgressSlider"
                Maximum="1"
                Minimum="0"
                ValueChanged="OnSliderValueChanged" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Clicked="OnAnimateClicked" Text="Animate with MAUI" />
                <Label
                    x:Name="ProgressLabel"
                    Grid.Column="1"
                    Text="Progress 0.000"
                    VerticalTextAlignment="Center" />
            </Grid>
            <ScrollView
                x:Name="ProgressScroller"
                HeightRequest="54"
                HorizontalScrollBarVisibility="Always"
                Orientation="Horizontal"
                Scrolled="OnProgressScrolled">
                <Grid
                    x:Name="ScrollTrack"
                    BackgroundColor="#18243A"
                    ColumnDefinitions="300,300,300,300"
                    HeightRequest="44">
                    <Label
                        Margin="12,0"
                        Text="0% — start"
                        TextColor="White"
                        VerticalTextAlignment="Center" />
                    <Label
                        Grid.Column="1"
                        Margin="12,0"
                        Text="33%"
                        TextColor="White"
                        VerticalTextAlignment="Center" />
                    <Label
                        Grid.Column="2"
                        Margin="12,0"
                        Text="66%"
                        TextColor="White"
                        VerticalTextAlignment="Center" />
                    <Label
                        Grid.Column="3"
                        Margin="12,0"
                        Text="100% — end"
                        TextColor="White"
                        VerticalTextAlignment="Center" />
                </Grid>
            </ScrollView>
            <Label
                x:Name="StatusLabel"
                FontSize="12"
                Text="Drag the slider/scroll strip or run a MAUI VSync animation." />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
