<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mu3D.Gallery.Pages.HdrProbePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mu3d="clr-namespace:Mu3D.Maui.Controls;assembly=Mu3D.Maui"
    Title="HDR Probe">
    <Grid RowDefinitions="*,Auto">
        <mu3d:Mu3DView x:Name="SurfaceView" BackgroundColor="#202020"
            WindowsMatchSdrWhite="{Binding Source={x:Reference WhiteSwitch}, Path=IsToggled}" />
        <ScrollView Grid.Row="1" MaximumHeightRequest="300">
            <VerticalStackLayout Padding="16" Spacing="12">
                <HorizontalStackLayout Spacing="12" IsVisible="{OnPlatform Default=False, WinUI=True}">
                    <Label Text="Match Windows SDR white" VerticalOptions="Center" />
                    <Switch x:Name="WhiteSwitch" IsToggled="True" />
                </HorizontalStackLayout>
                <Label FontAttributes="Bold" FontSize="18" Text="Native Surface Probe" />
                <Label
                    x:Name="ProbeStatus"
                    FontAttributes="Bold"
                    Text="Waiting for a native surface…" />
                <Button
                    x:Name="ProbeButton"
                    Clicked="OnProbeClicked"
                    IsEnabled="False"
                    Text="Probe surface capabilities" />
                <Button
                    x:Name="PresentButton"
                    Clicked="OnPresentClicked"
                    IsEnabled="False"
                    Text="Present extended-linear sRGB reference pattern" />
                <Button
                    x:Name="ReadbackButton"
                    Clicked="OnReadbackClicked"
                    IsEnabled="False"
                    IsVisible="{OnPlatform Default=False, Android=True}"
                    Text="Read actual reference pixels" />
                <Button
                    Clicked="OnCopyDiagnosticsClicked"
                    Text="Copy diagnostics" />
                <Label
                    x:Name="ProbeDetails"
                    FontFamily="OpenSansRegular"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
