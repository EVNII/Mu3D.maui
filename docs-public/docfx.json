{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Mu3D.*.dll"
          ],
          "src": "../artifacts/docs/reference"
        }
      ],
      "references": [
        "../artifacts/docs/dependencies/*.dll"
      ],
      "dest": "../artifacts/docs/api",
      "disableGitFeatures": true,
      "memberLayout": "samePage",
      "namespaceLayout": "flattened"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "api.md",
          "toc.yml",
          "articles/**/*.md",
          "articles/**/toc.yml"
        ],
        "src": ".",
        "dest": "v0.1"
      },
      {
        "files": [
          "**/*.yml"
        ],
        "src": "../artifacts/docs/api",
        "dest": "v0.1/api"
      }
    ],
    "output": "../artifacts/docs/_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Mu3D",
      "_appTitle": "Mu3D documentation",
      "_enableSearch": true,
      "_disableContribution": true,
      "_disableGitFeatures": true
    }
  }
}
